unless(findNamespace("ycString")
    makeNamespace("ycString")
)
addToNamespace("ycString"
    mapcar('symbolToString '(
        Trim
        TrimStart
        TrimEnd
        Pad
        Width
        Split
        Join
        StartsWith
        EndsWith
        Replace
        Count
        Escape
        Unescape
        Words
        JoinWords
        Sanitize
        ToSnake
        ToKebab
        ToCamel
        ToPascal
        _TrimSide
        _Repeat
        _IsWhitespace
        _SplitWhitespace
        _SplitLiteral
        _KeepNonEmpty
        _IsUpperChar
        _IsLowerChar
        _IsDigitChar
        _IsWordChar
        _CapWord
    ))
)
unuseNamespace("ycString")

; END
