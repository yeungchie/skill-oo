unless(findNamespace("ycRegEx")
    makeNamespace("ycRegEx")
)
addToNamespace("ycRegEx"
    mapcar('symbolToString '(
        ReCompile
        ReMatch
        ReSearch
        ReFullmatch
        ReFindall
        ReFinditer
        RePartialp
        ReSplit
        ReSub
        ReSubn
        ReGetRecursionLimit
        ReSetRecursionLimit
        Pattern
        PatternData
        Match
        MatchData
        _MkPattern
        _OptsList
        _CompileOptsBits
        _ExecOptsBits
        _CompileChecked
        _AsPat
        _FlagsFromValue
        _Suffix
        _Prefix
        _SplitBy
        _CountSub
        _Nth1
        _Backref
        _FoldCat
        _WholeTemplate
        _SplitTemplate
        _ExtractParts
        _PosMarker
        _ExportMarkers
        _ExportTemplate
        _ExportRecords
        _HasBit
        _HasNumericGroupRef
        _ZeroAtStart
        _ZeroWidthRecords
        _WalkRecords
        _MatchStart
        _NextMatch
        _AnchorAt
        _FindAllItem
        _MkMatch
        _GroupWhole
        _GroupAt
        _InstallPattern
        _InstallMatch
    ))
)
unuseNamespace("ycRegEx")

; END
