unless(findNamespace("ycJson")
    makeNamespace("ycJson")
)
addToNamespace("ycJson"
    mapcar('symbolToString '(
        Decode
        Encode
        _MaxDecodeDepth
        _MaxEncodeDepth
        _Code
        _Digitp
        _LineCol
        _Error
        _Build
        _SkipWs
        _Hex4
        _Utf8Str
        _Literal
        _Number
        _String
        _Value
        _Object
        _Array
        _DecodeText
        _LineSplit
        _LineBlankp
        _Newlines
        _KeyStr
        _IndentStr
        _EncodeString
        _EncodeNumber
        _EncodeValue
        _EncodeList
        _EncodeTable
    ))
)
unuseNamespace("ycJson")

; END
