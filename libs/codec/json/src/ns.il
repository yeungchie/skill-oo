unless(findNamespace("ycJson")
    makeNamespace("ycJson")
)
addToNamespace("ycJson"
    mapcar('symbolToString '(
        decode
        encode
        Type
        TypeData
        True
        False
        Null
        Missing
        _TypeCache
        _maxDecodeDepth
        _maxEncodeDepth
        _code
        _digitp
        _lineCol
        _error
        _build
        _skipWs
        _hex4
        _utf8Str
        _literal
        _number
        _string
        _value
        _object
        _array
        _decodeText
        _lineSplit
        _lineBlankp
        _newlines
        _keyStr
        _indentStr
        _encodeString
        _encodeNumber
        _encodeValue
        _encodeList
        _encodeTable
    ))
)
unuseNamespace("ycJson")

; END
