unless(findNamespace("ycPathLib")
    makeNamespace("ycPathLib")
)
addToNamespace("ycPathLib"
    mapcar('symbolToString '(
        Path
        PathData
        Cwd
        Home
        CurrentFile
        _AsPath
        _ParsePath
        _PathKey
        _MkPath
        _LastItem
        _DropLast
        _DropFirstN
        _DotIndex
        _LstripDots
        _SplitKeep
        _EndsWith
        _FnmatchBracket
        _FnmatchToPcre
        _Fnmatch1
        _CanMatchEmpty
        _AllMatchp
        _SuffixMatchp
        _StrMember
        _ShellQuote
        _InstallPure
        _FsName
        _DirNames
        _InstallFs
        _CollapseStars
        _GlobDirs
        _GlobTree
        _GlobChain
        _GlobPattern
        _InstallGlob
        _InstallCodec
    ))
)
unuseNamespace("ycPathLib")

; END
