; --- 构造与形状 ---
let((tab)
    tab = ycCsv::Table(nil)
    _Assert(tab->rowCount() == 0  "table: empty row count")
    _Assert(tab->columnCount() == 0  "table: empty column count")
    _Assert(tab->header() == nil  "table: empty header")
    _Assert(tab->rows() == nil  "table: empty rows")
)
let((tab)
    tab = ycCsv::Table(list(list("a" "b") list("c" "d")))
    _Assert(classOf(tab) == findClass('ycCsv::Table)  "table: class identity")
    _Assert(tab->rowCount() == 2  "table: row count")
    _Assert(tab->columnCount() == 2  "table: column count")
    _Assert(tab->header() == nil  "table: no header")
    _AssertRows(tab->row(1) list("a" "b")  "table: first row")
    _AssertRows(tab->row(2) list("c" "d")  "table: second row")
    _Assert(!eq(tab->row(1) car(tab->rows()))  "table: row returns a copy")
    _Assert(tab->cell(1 2) == "b"  "table: cell")
    _Assert(tab->cell(2 1) == "c"  "table: cell second row")
    _AssertRows(tab->columnAt(2) list("b" "d")  "table: column")
)
let((tab)
    tab = ycCsv::Table(list(list("1" "2")) ?header list("a" "b"))
    _AssertRows(tab->header() list("a" "b")  "table: header names")
    _Assert(tab->columnCount() == 2  "table: header column count")
    _Assert(tab->value(1 "a") == "1"  "table: value by name")
    _Assert(tab->value(1 "b") == "2"  "table: value by second name")
)
let((tab)
    tab = ycCsv::Table(nil ?header list("a" "b" "c"))
    _Assert(tab->rowCount() == 0  "table: header only row count")
    _Assert(tab->columnCount() == 3  "table: header only column count")
    _AssertRows(tab->header() list("a" "b" "c")  "table: header only names")
)
let((tab)
    tab = ycCsv::Table(list(list("a") list("b" "c" "d")))
    _Assert(tab->columnCount() == 3  "table: ragged column count")
    _Assert(tab->cell(1 1) == "a"  "table: ragged first cell")
    _Assert(tab->cell(1 3) == ycCodec::Missing  "table: ragged missing cell")
    _Assert(tab->cell(2 3) == "d"  "table: ragged present cell")
    _Assert(car(tab->columnAt(3)) == ycCodec::Missing  "table: ragged column missing")
    _Assert(cadr(tab->columnAt(3)) == "d"  "table: ragged column present")
)
let((tab)
    tab = ycCsv::Table(list(list("x")) ?header list("a" "b"))
    _Assert(tab->cell(1 1) == "x"  "table: short row first cell")
    _Assert(tab->cell(1 2) == ycCodec::Missing  "table: short row missing cell")
    _Assert(car(tab->columnAt(2)) == ycCodec::Missing  "table: short row column missing")
)
let((tab)
    tab = ycCsv::Table(list(list("1")) ?header list(""))
    _Assert(tab->value(1 "") == "1"  "table: empty header name")
)

; --- 打印 ---
let((tab)
    tab = ycCsv::Table(list(list("a" "b")) ?header list("x" "y"))
    _Assert(printself(tab) == "<ycCsv::Table rows=1 columns=2>"  "table: printself")
)

; --- 方法边界 ---
let((tab)
    tab = ycCsv::Table(list(list("a" "b")))
    _AssertError(lambda(() tab->row(0) t)  "table: row 0 errors")
    _AssertError(lambda(() tab->row(2) t)  "table: row beyond end errors")
    _AssertError(lambda(() tab->row(1.5) t)  "table: float row errors")
    _AssertError(lambda(() tab->row("a") t)  "table: string row errors")
    _AssertError(lambda(() tab->cell(0 1) t)  "table: cell row 0 errors")
    _AssertError(lambda(() tab->cell(1 0) t)  "table: cell column 0 errors")
    _AssertError(lambda(() tab->cell(1 3) t)  "table: cell column beyond end errors")
    _AssertError(lambda(() tab->cell(1.5 1) t)  "table: cell float row errors")
    _AssertError(lambda(() tab->cell(1 1.5) t)  "table: cell float column errors")
    _AssertError(lambda(() tab->cell(1 'a) t)  "table: cell symbol column errors")
    _AssertError(lambda(() tab->columnAt(0) t)  "table: column 0 errors")
    _AssertError(lambda(() tab->columnAt(3) t)  "table: column beyond end errors")
    _AssertError(lambda(() tab->value(1 "a") t)  "table: value without header errors")
)
let((tab)
    tab = ycCsv::Table(list(list("a")) ?header list("x"))
    _AssertError(lambda(() tab->value(1 "y") t)  "table: unknown column name errors")
    _AssertError(lambda(() tab->value(2 "x") t)  "table: value row beyond end errors")
    _AssertErrorMsg(lambda(() tab->value(2 "x") t) "->value: row index"  "table: value row error names value")
    _AssertError(lambda(() tab->value(1 1) t)  "table: value non-string name errors")
    _AssertError(lambda(() tab->value(1.5 "x") t)  "table: value float row errors")
)

; --- 构造校验 ---
_AssertError(lambda(() ycCsv::Table("a") t)  "table: rows string errors")
_AssertError(lambda(() ycCsv::Table(1) t)  "table: rows fixnum errors")
_AssertError(lambda(() ycCsv::Table(1.5) t)  "table: rows flonum errors")
_AssertError(lambda(() ycCsv::Table('a) t)  "table: rows symbol errors")
_AssertError(lambda(() ycCsv::Table(list("a")) t)  "table: row string errors")
_AssertError(lambda(() ycCsv::Table(list(nil)) t)  "table: empty row errors")
_AssertError(lambda(() ycCsv::Table(list(list('a))) t)  "table: symbol field errors")
_AssertError(lambda(() ycCsv::Table(list(list(1))) t)  "table: fixnum field errors")
_AssertError(lambda(() ycCsv::Table(list(list(1.5))) t)  "table: flonum field errors")
_AssertError(lambda(() ycCsv::Table(nil ?header "a") t)  "table: header string errors")
_AssertError(lambda(() ycCsv::Table(nil ?header t) t)  "table: header t errors")
_AssertError(lambda(() ycCsv::Table(nil ?header 1) t)  "table: header fixnum errors")
_AssertError(lambda(() ycCsv::Table(nil ?header list('a)) t)  "table: header symbol errors")
_AssertError(lambda(() ycCsv::Table(nil ?header list(1)) t)  "table: header fixnum element errors")
_AssertError(lambda(() ycCsv::Table(nil ?header list("a" "a")) t)  "table: duplicate header errors")
_AssertError(lambda(() ycCsv::Table(list(list("1" "2")) ?header list("a")) t)  "table: row wider than header errors")

_TestChildDone = t

; END
