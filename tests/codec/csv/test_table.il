; --- 构造与形状 ---
let((t_tab)
    t_tab = ycCsv::Table(nil)
    _assert(t_tab->rowCount() == 0  "table: empty row count")
    _assert(t_tab->columnCount() == 0  "table: empty column count")
    _assert(t_tab->header() == nil  "table: empty header")
    _assert(t_tab->rows() == nil  "table: empty rows")
)
let((t_tab)
    t_tab = ycCsv::Table(list(list("a" "b") list("c" "d")))
    _assert(classOf(t_tab) == findClass('ycCsv::Table)  "table: class identity")
    _assert(t_tab->rowCount() == 2  "table: row count")
    _assert(t_tab->columnCount() == 2  "table: column count")
    _assert(t_tab->header() == nil  "table: no header")
    _assertRows(t_tab->row(1) list("a" "b")  "table: first row")
    _assertRows(t_tab->row(2) list("c" "d")  "table: second row")
    _assert(t_tab->cell(1 2) == "b"  "table: cell")
    _assert(t_tab->cell(2 1) == "c"  "table: cell second row")
    _assertRows(t_tab->columnAt(2) list("b" "d")  "table: column")
)
let((t_tab)
    t_tab = ycCsv::Table(list(list("1" "2")) ?header list("a" "b"))
    _assertRows(t_tab->header() list("a" "b")  "table: header names")
    _assert(t_tab->columnCount() == 2  "table: header column count")
    _assert(t_tab->value(1 "a") == "1"  "table: value by name")
    _assert(t_tab->value(1 "b") == "2"  "table: value by second name")
)
let((t_tab)
    t_tab = ycCsv::Table(nil ?header list("a" "b" "c"))
    _assert(t_tab->rowCount() == 0  "table: header only row count")
    _assert(t_tab->columnCount() == 3  "table: header only column count")
    _assertRows(t_tab->header() list("a" "b" "c")  "table: header only names")
)
let((t_tab)
    t_tab = ycCsv::Table(list(list("a") list("b" "c" "d")))
    _assert(t_tab->columnCount() == 3  "table: ragged column count")
    _assert(t_tab->cell(1 1) == "a"  "table: ragged first cell")
    _assert(t_tab->cell(1 3) == ycCodec::Missing  "table: ragged missing cell")
    _assert(t_tab->cell(2 3) == "d"  "table: ragged present cell")
    _assert(car(t_tab->columnAt(3)) == ycCodec::Missing  "table: ragged column missing")
    _assert(cadr(t_tab->columnAt(3)) == "d"  "table: ragged column present")
)
let((t_tab)
    t_tab = ycCsv::Table(list(list("x")) ?header list("a" "b"))
    _assert(t_tab->cell(1 1) == "x"  "table: short row first cell")
    _assert(t_tab->cell(1 2) == ycCodec::Missing  "table: short row missing cell")
    _assert(car(t_tab->columnAt(2)) == ycCodec::Missing  "table: short row column missing")
)
let((t_tab)
    t_tab = ycCsv::Table(list(list("1")) ?header list(""))
    _assert(t_tab->value(1 "") == "1"  "table: empty header name")
)

; --- 打印 ---
let((t_tab)
    t_tab = ycCsv::Table(list(list("a" "b")) ?header list("x" "y"))
    _assert(printself(t_tab) == "<ycCsv::Table rows=1 columns=2>"  "table: printself")
)

; --- 方法边界 ---
let((t_tab)
    t_tab = ycCsv::Table(list(list("a" "b")))
    _assertError(lambda(() t_tab->row(0) t)  "table: row 0 errors")
    _assertError(lambda(() t_tab->row(2) t)  "table: row beyond end errors")
    _assertError(lambda(() t_tab->row(1.5) t)  "table: float row errors")
    _assertError(lambda(() t_tab->row("a") t)  "table: string row errors")
    _assertError(lambda(() t_tab->cell(0 1) t)  "table: cell row 0 errors")
    _assertError(lambda(() t_tab->cell(1 0) t)  "table: cell column 0 errors")
    _assertError(lambda(() t_tab->cell(1 3) t)  "table: cell column beyond end errors")
    _assertError(lambda(() t_tab->cell(1.5 1) t)  "table: cell float row errors")
    _assertError(lambda(() t_tab->cell(1 1.5) t)  "table: cell float column errors")
    _assertError(lambda(() t_tab->cell(1 'a) t)  "table: cell symbol column errors")
    _assertError(lambda(() t_tab->columnAt(0) t)  "table: column 0 errors")
    _assertError(lambda(() t_tab->columnAt(3) t)  "table: column beyond end errors")
    _assertError(lambda(() t_tab->value(1 "a") t)  "table: value without header errors")
)
let((t_tab)
    t_tab = ycCsv::Table(list(list("a")) ?header list("x"))
    _assertError(lambda(() t_tab->value(1 "y") t)  "table: unknown column name errors")
    _assertError(lambda(() t_tab->value(2 "x") t)  "table: value row beyond end errors")
    _assertError(lambda(() t_tab->value(1 1) t)  "table: value non-string name errors")
    _assertError(lambda(() t_tab->value(1.5 "x") t)  "table: value float row errors")
)

; --- 构造校验 ---
_assertError(lambda(() ycCsv::Table("a") t)  "table: rows string errors")
_assertError(lambda(() ycCsv::Table(1) t)  "table: rows fixnum errors")
_assertError(lambda(() ycCsv::Table(1.5) t)  "table: rows flonum errors")
_assertError(lambda(() ycCsv::Table('a) t)  "table: rows symbol errors")
_assertError(lambda(() ycCsv::Table(list("a")) t)  "table: row string errors")
_assertError(lambda(() ycCsv::Table(list(nil)) t)  "table: empty row errors")
_assertError(lambda(() ycCsv::Table(list(list('a))) t)  "table: symbol field errors")
_assertError(lambda(() ycCsv::Table(list(list(1))) t)  "table: fixnum field errors")
_assertError(lambda(() ycCsv::Table(list(list(1.5))) t)  "table: flonum field errors")
_assertError(lambda(() ycCsv::Table(nil ?header "a") t)  "table: header string errors")
_assertError(lambda(() ycCsv::Table(nil ?header t) t)  "table: header t errors")
_assertError(lambda(() ycCsv::Table(nil ?header 1) t)  "table: header fixnum errors")
_assertError(lambda(() ycCsv::Table(nil ?header list('a)) t)  "table: header symbol errors")
_assertError(lambda(() ycCsv::Table(nil ?header list(1)) t)  "table: header fixnum element errors")
_assertError(lambda(() ycCsv::Table(nil ?header list("a" "a")) t)  "table: duplicate header errors")
_assertError(lambda(() ycCsv::Table(list(list("1" "2")) ?header list("a")) t)  "table: row wider than header errors")

_TestTableDone = t

; END
