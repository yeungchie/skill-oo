;--------------------------
; Program  : ycToml tests(test_decode.il)
; Language : Cadence Skill
;--------------------------

let((t_v t_arr t_a t_b)
    t_v = ycToml::Decode("")
    _Assert(length(t_v) == 0  "decode: empty document")
    _Assert(t_v["absent"] == ycCodec::Missing  "decode: missing key is Missing")

    t_v = ycToml::Decode("# comment only\n\n")
    _Assert(length(t_v) == 0  "decode: comment only")

    t_v = ycToml::Decode("title = \"TOML\"\nanswer = 42\nok = true\n")
    _Assert(t_v["title"] == "TOML"  "decode: basic string")
    _Assert(t_v["answer"] == 42  "decode: decimal integer")
    _Assert(t_v["ok"] == ycCodec::True  "decode: true sentinel")

    t_v = ycToml::Decode("a.b.c = 1\n")
    _Assert(t_v["a"]["b"]["c"] == 1  "decode: dotted key")

    t_v = ycToml::Decode("\"a.b\" = 1\n'c d' = 2\n")
    _Assert(t_v["a.b"] == 1  "decode: quoted dotted key")
    _Assert(t_v["c d"] == 2  "decode: literal key")

    t_v = ycToml::Decode("s = \"a\\nb\\t\\\"\\\\\\u4e2d\\U0001F600\"\n")
    _Assert(t_v["s"] == "a\nb\t\"\\中\360\237\230\200"  "decode: basic escapes")

    t_v = ycToml::Decode("s = 'C:\\Users\\n'\n")
    _Assert(t_v["s"] == "C:\\Users\\n"  "decode: literal string")

    t_v = ycToml::Decode("s = \"\"\"\nline1\nline2\"\"\"\n")
    _Assert(t_v["s"] == "line1\nline2"  "decode: multiline basic trims first newline")

    t_v = ycToml::Decode("s = \"\"\"a\"\"\"\"\n")
    _Assert(t_v["s"] == "a\""  "decode: multiline closing quote run")
    t_v = ycToml::Decode("s = \"\"\"a\"\"\"\"\"\n")
    _Assert(t_v["s"] == "a\"\""  "decode: multiline two closing quotes")
    _AssertError(lambda(() ycToml::Decode("s = \"\"\"a\"\"\"\"\"\"\n"))  "decode: six closing quotes error")
    t_v = ycToml::Decode("s = \"\"\n")
    _Assert(t_v["s"] == ""  "decode: empty basic string")
    t_v = ycToml::Decode("s = ''\n")
    _Assert(t_v["s"] == ""  "decode: empty literal string")

    t_v = ycToml::Decode("s = \"\"\"a \\\n   b\"\"\"\n")
    _Assert(t_v["s"] == "a b"  "decode: multiline basic line continuation")

    t_v = ycToml::Decode("s = '''\nline1\nline2'''\n")
    _Assert(t_v["s"] == "line1\nline2"  "decode: multiline literal")
    _AssertError(lambda(() ycToml::Decode("s = '''a''''''\n"))  "decode: six literal closing quotes error")

    t_v = ycToml::Decode("a = 1_000\nb = +42\nc = -0\nd = 0x7FFF_FFFF\ne = 0o755\nf = 0b1010\n")
    _Assert(t_v["a"] == 1000  "decode: decimal underscores")
    _Assert(t_v["b"] == 42  "decode: explicit plus")
    _Assert(t_v["c"] == 0  "decode: negative zero integer")
    _Assert(t_v["d"] == 2147483647  "decode: hexadecimal")
    _Assert(t_v["e"] == 493  "decode: octal")
    _Assert(t_v["f"] == 10  "decode: binary")

    t_v = ycToml::Decode("a = 2147483647\nb = -2147483648\n")
    _Assert(t_v["a"] == 2147483647  "decode: fixnum max")
    _Assert(t_v["b"] == (-2147483647 - 1)  "decode: fixnum min")

    t_v = ycToml::Decode("a = 1.0\nb = -0.0\nc = 5e+22\nd = 1_000.5_0\ne = inf\nf = -inf\ng = nan\n")
    _Assert(t_v["a"] == 1.0  "decode: float")
    _Assert(t_v["b"] == 0.0  "decode: negative zero float")
    _Assert(t_v["c"] == 5e+22  "decode: exponent float")
    _Assert(t_v["d"] == 1000.5  "decode: float underscores")
    _Assert(isInfinity(t_v["e"]) && t_v["e"] > 0  "decode: inf")
    _Assert(isInfinity(t_v["f"]) && t_v["f"] < 0  "decode: negative inf")
    _Assert(isNaN(t_v["g"])  "decode: nan")

    t_v = ycToml::Decode("a = false\n")
    _Assert(t_v["a"] == ycCodec::False  "decode: false sentinel")

    t_v = ycToml::Decode("d = 1979-05-27\nt = 07:32:00.999\ndt = 1979-05-27T07:32:00Z\ndt2 = 1979-05-27 07:32:00-07:00\n")
    _Assert(t_v["d"] == "1979-05-27"  "decode: local date as string")
    _Assert(t_v["t"] == "07:32:00.999"  "decode: local time as string")
    _Assert(t_v["dt"] == "1979-05-27T07:32:00Z"  "decode: offset datetime as string")
    _Assert(t_v["dt2"] == "1979-05-27 07:32:00-07:00"  "decode: space datetime as string")

    t_v = ycToml::Decode("a = []\nb = [1, 2, 3,]\nc = [\n  1, # one\n  2,\n]\nd = [[1], [2, 3]]\ne = [1, \"two\"]\n")
    _Assert(t_v["a"] == nil  "decode: empty array is nil")
    _Assert(t_v["b"] == list(1 2 3)  "decode: trailing comma array")
    _Assert(t_v["c"] == list(1 2)  "decode: multiline commented array")
    _Assert(t_v["d"] == list(list(1) list(2 3))  "decode: nested arrays")
    _Assert(t_v["e"] == list(1 "two")  "decode: mixed array")
    t_v = ycToml::Decode("a = [[], [1]]\n")
    _Assert(t_v["a"] == list(nil list(1))  "decode: nested empty array")

    t_v = ycToml::Decode("point = { x = 1, y = 2 }\nempty = {}\ndotted = { a.b = 3 }\n")
    _Assert(t_v["point"]["x"] == 1 && t_v["point"]["y"] == 2  "decode: inline table")
    _Assert(length(t_v["empty"]) == 0  "decode: empty inline table")
    _Assert(t_v["dotted"]["a"]["b"] == 3  "decode: dotted inline key")

    t_v = ycToml::Decode("arr = [{ x = 1 }, { x = 2 }]\n")
    _Assert(car(t_v["arr"])["x"] == 1 && cadr(t_v["arr"])["x"] == 2  "decode: array of inline tables")

    t_v = ycToml::Decode("[server]\nhost = \"localhost\"\n[server.tls]\nenabled = true\n")
    _Assert(t_v["server"]["host"] == "localhost"  "decode: table header")
    _Assert(t_v["server"]["tls"]["enabled"] == ycCodec::True  "decode: nested table header")

    t_v = ycToml::Decode("[a.b]\nx = 1\n[a]\ny = 2\n")
    _Assert(t_v["a"]["b"]["x"] == 1 && t_v["a"]["y"] == 2  "decode: implicit table later explicit")

    t_v = ycToml::Decode("[[fruits]]\nname = \"apple\"\n[fruits.physical]\ncolor = \"red\"\n[[fruits.varieties]]\nname = \"red delicious\"\n[[fruits.varieties]]\nname = \"granny smith\"\n[[fruits]]\nname = \"banana\"\n[[fruits.varieties]]\nname = \"plantain\"\n")
    _Assert(length(t_v["fruits"]) == 2  "decode: nested array tables count")
    _Assert(car(t_v["fruits"])["physical"]["color"] == "red"  "decode: physical subtable")
    _Assert(length(car(t_v["fruits"])["varieties"]) == 2  "decode: first element varieties")
    _Assert(car(cadr(t_v["fruits"])["varieties"])["name"] == "plantain"  "decode: second element varieties")

    t_v = ycToml::Decode("[[products]]\nname = \"Hammer\"\n[[products]]\nname = \"Nail\"\n")
    _Assert(length(t_v["products"]) == 2  "decode: array of tables length")
    _Assert(car(t_v["products"])["name"] == "Hammer"  "decode: first array table")
    _Assert(cadr(t_v["products"])["name"] == "Nail"  "decode: second array table")

    t_v = ycToml::Decode("[[a]]\nx = 1\n[a.b]\ny = 2\n[[a]]\nx = 3\n[a.b]\ny = 4\n")
    _Assert(car(t_v["a"])["b"]["y"] == 2  "decode: subtable of first array table")
    _Assert(cadr(t_v["a"])["b"]["y"] == 4  "decode: subtable of second array table")

    t_v = ycToml::Decode(strcat(intToChar(239) intToChar(187) intToChar(191) "a = 1\r\nb = 2\r\n"))
    _Assert(t_v["a"] == 1 && t_v["b"] == 2  "decode: BOM and CRLF")

    t_v = ycToml::Decode("\"\" = 1\n")
    _Assert(t_v[""] == 1  "decode: empty quoted key")
    t_v = ycToml::Decode("\"a\\nb\" = 1\n")
    _Assert(t_v["a\nb"] == 1  "decode: escaped newline key")

    t_v = ycToml::Decode("a = 2024-02-29\n")
    _Assert(t_v["a"] == "2024-02-29"  "decode: leap day")
    t_v = ycToml::Decode("a = \"\"\"x \\   \n   y\"\"\"\n")
    _Assert(t_v["a"] == "x y"  "decode: continuation with spaces")

    _AssertError(lambda(() ycToml::Decode("a = \"\"\"x \\  y\"\"\"\n"))  "decode: invalid continuation errors")
    _AssertError(lambda(() ycToml::Decode("\"\"\"a\"\"\" = 1\n"))  "decode: triple-quoted basic key errors")
    _AssertError(lambda(() ycToml::Decode("'''a''' = 1\n"))  "decode: triple-quoted literal key errors")
    _AssertError(lambda(() ycToml::Decode("a = 2023-02-29\n"))  "decode: non-leap day errors")
    _AssertError(lambda(() ycToml::Decode("a = 1979-05-27T07:32:00+24:00\n"))  "decode: invalid offset errors")
    _AssertError(lambda(() ycToml::Decode("a = 1979-05-27T07:32:00.\n"))  "decode: empty fraction errors")
    _AssertError(lambda(() ycToml::Decode("a = 1979-05-27T07:32:00Zx\n"))  "decode: datetime trailing garbage errors")
    _AssertError(lambda(() ycToml::Decode("a = 07:32:00Z\n"))  "decode: local time with offset errors")
    _AssertError(lambda(() ycToml::Decode("[[a]]\n[a]\n"))  "decode: array table then table errors")
    _AssertError(lambda(() ycToml::Decode("[a]\n[[a]]\n"))  "decode: table then array table errors")
    t_v = ycToml::Decode("a.b = 1\n[a.c]\ny = 2\n")
    _Assert(t_v["a"]["b"] == 1 && t_v["a"]["c"]["y"] == 2  "decode: header adds sibling to dotted table")
    t_v = ycToml::Decode("a.b.c = 1\n[a.b.d]\ny = 2\n")
    _Assert(t_v["a"]["b"]["c"] == 1 && t_v["a"]["b"]["d"]["y"] == 2  "decode: header adds subtable to dotted table")
    t_v = ycToml::Decode("[fruit]\napple.color = \"red\"\n[fruit.apple.texture]\nsmooth = true\n")
    _Assert(t_v["fruit"]["apple"]["texture"]["smooth"] == ycCodec::True  "decode: dotted table subtable header")
    _AssertError(lambda(() ycToml::Decode("a.b = 1\n[a]\n"))  "decode: header redefines dotted table")
    _AssertError(lambda(() ycToml::Decode("a.b = 1\n[a.b]\n"))  "decode: header redefines dotted leaf")
    _AssertError(lambda(() ycToml::Decode("a.b.c = 1\n[a.b]\n"))  "decode: header redefines dotted subtable")

    _AssertError(lambda(() ycToml::Decode("a = 1\na = 2\n"))  "decode: duplicate key errors")
    _AssertError(lambda(() ycToml::Decode("[a]\n[a]\n"))  "decode: duplicate table errors")
    _AssertError(lambda(() ycToml::Decode("a = 1\n[a]\n"))  "decode: scalar then table errors")
    _AssertError(lambda(() ycToml::Decode("a = { b = 1 }\na.c = 2\n"))  "decode: inline table cannot extend")
    _AssertError(lambda(() ycToml::Decode("a = { b = 1, }\n"))  "decode: inline trailing comma errors")
    _AssertError(lambda(() ycToml::Decode("a = { b = 1\n}\n"))  "decode: inline newline errors")
    _AssertError(lambda(() ycToml::Decode("a = \"unterminated\n"))  "decode: unterminated string errors")
    _AssertError(lambda(() ycToml::Decode("a = \"\\q\"\n"))  "decode: invalid escape errors")
    _AssertError(lambda(() ycToml::Decode(strcat("a = \"" intToChar(127) "\"\n")))  "decode: unescaped DEL errors")
    _AssertError(lambda(() ycToml::Decode(strcat("a = '" intToChar(127) "'\n")))  "decode: unescaped DEL literal errors")
    _AssertError(lambda(() ycToml::Decode(strcat("# " intToChar(1) "\na = 1\n")))  "decode: control in comment errors")
    _AssertError(lambda(() ycToml::Decode(strcat("a = 1 # " intToChar(127) "\n")))  "decode: DEL in comment errors")
    _AssertError(lambda(() ycToml::Decode(strcat("a = \"" intToChar(255) "\"\n")))  "decode: invalid UTF-8 lead errors")
    _AssertError(lambda(() ycToml::Decode(strcat("a = \"" intToChar(192) intToChar(128) "\"\n")))  "decode: overlong UTF-8 errors")
    _AssertError(lambda(() ycToml::Decode(strcat("a = \"" intToChar(237) intToChar(160) intToChar(128) "\"\n")))  "decode: surrogate UTF-8 errors")
    _AssertError(lambda(() ycToml::Decode(strcat("a = \"" intToChar(244) intToChar(144) intToChar(128) intToChar(128) "\"\n")))  "decode: out-of-range UTF-8 errors")
    _AssertError(lambda(() ycToml::Decode("a = 01\n"))  "decode: leading zero errors")
    _AssertError(lambda(() ycToml::Decode("a = 1_\n"))  "decode: trailing underscore errors")
    _AssertError(lambda(() ycToml::Decode("a = .5\n"))  "decode: leading dot float errors")
    _AssertError(lambda(() ycToml::Decode("a = 1.\n"))  "decode: trailing dot float errors")
    _AssertError(lambda(() ycToml::Decode("a = 2147483648\n"))  "decode: integer overflow errors")
    _AssertError(lambda(() ycToml::Decode("a = 0xFFFFFFFF\n"))  "decode: hex overflow errors")
    _AssertError(lambda(() ycToml::Decode("a = 0x80000000\n"))  "decode: hex sign bit overflow errors")
    _AssertError(lambda(() ycToml::Decode("a = 0o20000000000\n"))  "decode: octal overflow errors")
    _AssertError(lambda(() ycToml::Decode("a = 0b10000000000000000000000000000000\n"))  "decode: binary overflow errors")
    _AssertError(lambda(() ycToml::Decode("a = 2024-13-01\n"))  "decode: invalid month errors")
    _AssertError(lambda(() ycToml::Decode("a = 2024-02-30\n"))  "decode: invalid day errors")
    _AssertError(lambda(() ycToml::Decode("a = 24:00:00\n"))  "decode: invalid time errors")
    _AssertError(lambda(() ycToml::Decode("a = 1\ntrailing\n"))  "decode: trailing garbage errors")
    _AssertError(lambda(() ycToml::Decode("[a\n"))  "decode: unterminated table errors")
    _AssertError(lambda(() ycToml::Decode(1))  "decode: non-string input errors")
    _AssertError(lambda(() ycToml::Decode("a = 1" ?maxDepth 0))  "decode: zero maxDepth errors")
    _AssertError(lambda(() ycToml::Decode("a = 1" ?maxDepth 1.5))  "decode: float maxDepth errors")
    _AssertError(lambda(() ycToml::Decode("a = [[1]]" ?maxDepth 1))  "decode: nesting limit errors")
    _AssertError(lambda(() ycToml::Decode("a.b = 1" ?maxDepth 1))  "decode: dotted key depth limit")
    _Assert(ycToml::Decode("a.b = 1" ?maxDepth 2)["a"]["b"] == 1  "decode: dotted key within depth")

    _AssertErrorMsg(lambda(() ycToml::Decode("a = 1\na = 2\n")) "duplicate key"  "decode: duplicate key message")
    _AssertErrorMsg(lambda(() ycToml::Decode("a = 1\ntrailing\n")) "line 2"  "decode: error line number")
)
_TestDecodeDone = t

; END
