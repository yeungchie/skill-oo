; --- 字面量 ---
_assert(ycCodec::jsonParse("true") == t  "parse: true")
_assert(ycCodec::jsonParse("false") == ycCodec::jsonFalse  "parse: false")
_assert(ycCodec::jsonParse("null") == ycCodec::jsonNull  "parse: null")
_assert(!(ycCodec::jsonParse("null") == nil)  "parse: null is not nil")
_assert(ycCodec::jsonParse("  false \n\t") == ycCodec::jsonFalse  "parse: literal with surrounding whitespace")
_assertError(lambda(() ycCodec::jsonParse(""))  "parse: empty input errors")
_assertError(lambda(() ycCodec::jsonParse("   "))  "parse: blank input errors")
_assertError(lambda(() ycCodec::jsonParse("tru"))  "parse: truncated true errors")
_assertError(lambda(() ycCodec::jsonParse("TRUE"))  "parse: uppercase TRUE errors")
_assertError(lambda(() ycCodec::jsonParse("False"))  "parse: capitalized False errors")
_assertError(lambda(() ycCodec::jsonParse("nullx"))  "parse: nullx errors")
_assertErrorMsg(lambda(() ycCodec::jsonParse("true x")) "unexpected trailing characters"  "parse: trailing chars message")

; --- 数字 ---
_assert(ycCodec::jsonParse("42") == 42  "parse: 42")
_assert(fixp(ycCodec::jsonParse("42"))  "parse: 42 is fixnum")
_assert(ycCodec::jsonParse("-7") == -7  "parse: -7")
_assert(ycCodec::jsonParse("0") == 0  "parse: 0")
_assert(ycCodec::jsonParse("-0") == 0  "parse: -0 -> 0")
_assert(fixp(ycCodec::jsonParse("-0"))  "parse: -0 is fixnum")
_assert(ycCodec::jsonParse("3.14") == 3.14  "parse: 3.14")
_assert(floatp(ycCodec::jsonParse("3.14"))  "parse: 3.14 is flonum")
_assert(ycCodec::jsonParse("1e3") == 1000.0  "parse: 1e3")
_assert(floatp(ycCodec::jsonParse("1e3"))  "parse: 1e3 is flonum")
_assert(ycCodec::jsonParse("1E-2") == 0.01  "parse: 1E-2")
_assert(ycCodec::jsonParse("2.5e+2") == 250.0  "parse: 2.5e+2")
_assert(ycCodec::jsonParse("2147483647") == 2147483647  "parse: fixnum max")
_assert(fixp(ycCodec::jsonParse("2147483647"))  "parse: fixnum max stays fixnum")
_assert(floatp(ycCodec::jsonParse("2147483648"))  "parse: overflow int becomes flonum")
_assert(ycCodec::jsonParse("2147483648") == atof("2147483648")  "parse: overflow value preserved")
_assert(ycCodec::jsonParse("-2147483648") == -atof("2147483648")  "parse: fixnum min")
_assert(fixp(ycCodec::jsonParse("-2147483648"))  "parse: fixnum min stays fixnum")
_assert(floatp(ycCodec::jsonParse("99999999999999999999"))  "parse: huge int becomes flonum")
_assertError(lambda(() ycCodec::jsonParse("+1"))  "parse: +1 errors")
_assertError(lambda(() ycCodec::jsonParse("-"))  "parse: lone minus errors")
_assertError(lambda(() ycCodec::jsonParse(".5"))  "parse: .5 errors")
_assertError(lambda(() ycCodec::jsonParse("5."))  "parse: 5. errors")
_assertError(lambda(() ycCodec::jsonParse("01"))  "parse: 01 errors")
_assertError(lambda(() ycCodec::jsonParse("-01"))  "parse: -01 errors")
_assertError(lambda(() ycCodec::jsonParse("1e"))  "parse: 1e errors")
_assertError(lambda(() ycCodec::jsonParse("1e+"))  "parse: 1e+ errors")
_assertError(lambda(() ycCodec::jsonParse("1.e3"))  "parse: 1.e3 errors")
_assertError(lambda(() ycCodec::jsonParse("1.2.3"))  "parse: 1.2.3 errors")
_assertError(lambda(() ycCodec::jsonParse("--1"))  "parse: --1 errors")
_assertError(lambda(() ycCodec::jsonParse("Infinity"))  "parse: Infinity errors")
_assertError(lambda(() ycCodec::jsonParse("NaN"))  "parse: NaN errors")
_assertError(lambda(() ycCodec::jsonParse("0x10"))  "parse: 0x10 errors")

; --- 字符串 ---
_assert(ycCodec::jsonParse("\"\"") == ""  "parse: empty string")
_assert(ycCodec::jsonParse("\"abc\"") == "abc"  "parse: plain string")
_assert(ycCodec::jsonParse("\"a\\\"b\"") == strcat("a" intToChar(34) "b")  "parse: escaped quote")
_assert(ycCodec::jsonParse("\"a\\\\b\"") == strcat("a" intToChar(92) "b")  "parse: escaped backslash")
_assert(ycCodec::jsonParse("\"a\\/b\"") == "a/b"  "parse: escaped slash")
_assert(
    ycCodec::jsonParse("\"\\b\\f\\n\\r\\t\"")
        == strcat(intToChar(8) intToChar(12) intToChar(10) intToChar(13) intToChar(9))
    "parse: short escapes"
)
_assert(ycCodec::jsonParse("\"\\u0041\"") == "A"  "parse: \\u0041")
_assert(ycCodec::jsonParse("\"\\u4E2D\"") == "中"  "parse: \\u4E2D")
_assert(ycCodec::jsonParse("\"\\u00e9\"") == strcat(intToChar(195) intToChar(169))  "parse: \\u00e9 to utf-8 bytes")
_assert(
    ycCodec::jsonParse("\"\\ud83d\\ude00\"")
        == strcat(intToChar(240) intToChar(159) intToChar(152) intToChar(128))
    "parse: surrogate pair to utf-8 bytes"
)
_assert(ycCodec::jsonParse("\"中\"") == "中"  "parse: utf-8 passes through")
_assertError(lambda(() ycCodec::jsonParse("\"\\ud800\""))  "parse: lone high surrogate errors")
_assertError(lambda(() ycCodec::jsonParse("\"\\udc00\""))  "parse: lone low surrogate errors")
_assertError(lambda(() ycCodec::jsonParse("\"\\ud800x\""))  "parse: high surrogate without pair errors")
_assertError(lambda(() ycCodec::jsonParse("\"\\ud800\\u0041\""))  "parse: high surrogate with non-low errors")
_assertError(lambda(() ycCodec::jsonParse("\"\\u12g4\""))  "parse: invalid hex digit errors")
_assertError(lambda(() ycCodec::jsonParse("\"\\u12\""))  "parse: short \\u escape errors")
_assertError(lambda(() ycCodec::jsonParse("\"\\x\""))  "parse: invalid escape errors")
_assertError(lambda(() ycCodec::jsonParse("\"abc"))  "parse: unterminated string errors")
_assertError(lambda(() ycCodec::jsonParse(strcat("\"" "a" intToChar(10) "b" "\"")))  "parse: raw control char errors")

; --- 数组 ---
_assert(ycCodec::jsonParse("[]") == nil  "parse: empty array -> nil")
_assertDumpEq(ycCodec::jsonParse("[1,2,3]") list(1 2 3)  "parse: [1,2,3]")
_assertDumpEq(ycCodec::jsonParse("[ 1 , 2 ]") list(1 2)  "parse: array with inner whitespace")
_assertDumpEq(ycCodec::jsonParse("[[]]") list(nil)  "parse: nested empty array")
_assertDumpEq(ycCodec::jsonParse("[true,false,null]") list(t ycCodec::jsonFalse ycCodec::jsonNull)  "parse: literal array")
_assertDumpEq(ycCodec::jsonParse("[1,[2,[3]]]") list(1 list(2 list(3)))  "parse: nested arrays")
_assert(car(ycCodec::jsonParse("[7]")) == 7  "parse: single element value")
_assertError(lambda(() ycCodec::jsonParse("[1,]"))  "parse: strict rejects trailing comma")
_assertError(lambda(() ycCodec::jsonParse("[,1]"))  "parse: rejects leading comma")
_assertError(lambda(() ycCodec::jsonParse("[1,,2]"))  "parse: rejects double comma")
_assertError(lambda(() ycCodec::jsonParse("[1"))  "parse: rejects unterminated array")
_assertError(lambda(() ycCodec::jsonParse("]"))  "parse: rejects stray close bracket")
_assertError(lambda(() ycCodec::jsonParse("[1]]"))  "parse: rejects extra close bracket")

; --- 对象 ---
_assert(length(ycCodec::jsonParse("{}")) == 0  "parse: empty object")
let((t_v)
    t_v = ycCodec::jsonParse("{\"a\":1}")
    _assert(length(t_v) == 1  "parse: object single key count")
    _assert(t_v["a"] == 1  "parse: object value")
    _assert(t_v["zz"] == ycCodec::jsonMissing  "parse: missing key returns jsonMissing")
)
let((t_v)
    t_v = ycCodec::jsonParse("{\"a\":null,\"b\":false,\"c\":true}")
    _assert(t_v["a"] == ycCodec::jsonNull  "parse: object null value")
    _assert(t_v["b"] == ycCodec::jsonFalse  "parse: object false value")
    _assert(t_v["c"] == t  "parse: object true value")
)
_assert(let((t_v) t_v = ycCodec::jsonParse("{\"a\":1,\"a\":2}") length(t_v) == 1)  "parse: duplicate keys collapse")
_assert(let((t_v) t_v = ycCodec::jsonParse("{\"a\":1,\"a\":2}") t_v["a"] == 2)  "parse: duplicate keys last wins")
let((t_v t_e t_in)
    t_v = ycCodec::jsonParse("{\"a\":{\"b\":[1]}}")
    t_e = makeTable("ycTest")
    t_in = makeTable("ycTest")
    t_in["b"] = list(1)
    t_e["a"] = t_in
    _assertDumpEq(t_v t_e  "parse: nested object")
)
_assertError(lambda(() ycCodec::jsonParse("{"))  "parse: rejects unterminated object")
_assertError(lambda(() ycCodec::jsonParse("{\"a\"}"))  "parse: rejects key without colon")
_assertError(lambda(() ycCodec::jsonParse("{\"a\":}"))  "parse: rejects missing value")
_assertError(lambda(() ycCodec::jsonParse("{\"a\":1,}"))  "parse: strict rejects object trailing comma")
_assertError(lambda(() ycCodec::jsonParse("{a:1}"))  "parse: rejects non-string key")
_assertError(lambda(() ycCodec::jsonParse("{\"a\" 1}"))  "parse: rejects missing colon")
_assertError(lambda(() ycCodec::jsonParse("{\"a\":1 \"b\":2}"))  "parse: rejects missing comma")
_assertError(lambda(() ycCodec::jsonParse("{,}"))  "parse: rejects comma without key")

; --- 嵌套深度 ---
_assert(errset(ycCodec::jsonParse(_nestArrays(1000)) nil) != nil  "parse: 1000-deep nesting ok")
_assertError(lambda(() ycCodec::jsonParse(_nestArrays(1001)))  "parse: 1001-deep nesting errors")
_assertErrorMsg(lambda(() ycCodec::jsonParse(_nestArrays(1001))) "nesting too deep"  "parse: deep nesting message")

; --- 错误位置 ---
_assertErrorMsg(lambda(() ycCodec::jsonParse("x")) "line 1, column 1"  "parse: error position line 1")
_assertErrorMsg(lambda(() ycCodec::jsonParse("\n\nx")) "line 3, column 1"  "parse: error position counts newlines")
_assertErrorMsg(lambda(() ycCodec::jsonParse("[1,\n2\n,x]")) "line 3, column 2"  "parse: array error position")
_assertErrorMsg(lambda(() ycCodec::jsonParse("{\"a\": 1,\n \"b\" 2}")) "line 2, column 6"  "parse: object error position")
_assertErrorMsg(lambda(() ycCodec::jsonParse("\"abc")) "unterminated string"  "parse: unterminated string message")

; --- 类型校验 ---
_assertError(lambda(() ycCodec::jsonParse(5))  "parse: rejects non-string input")
_assertError(lambda(() ycCodec::jsonParse(nil))  "parse: rejects nil input")

_TestParseDone = t

; END
