; --- 字面量 ---
_assert(ycJson::decode("true") == ycJson::True  "decode: true")
_assert(ycJson::decode("false") == ycJson::False  "decode: false")
_assert(ycJson::decode("null") == ycJson::Null  "decode: null")
_assert(!(ycJson::decode("null") == nil)  "decode: null is not nil")
_assert(ycJson::decode("  false \n\t") == ycJson::False  "decode: literal with surrounding whitespace")
_assertError(lambda(() ycJson::decode(""))  "decode: empty input errors")
_assertError(lambda(() ycJson::decode("   "))  "decode: blank input errors")
_assertError(lambda(() ycJson::decode("tru"))  "decode: truncated true errors")
_assertError(lambda(() ycJson::decode("TRUE"))  "decode: uppercase TRUE errors")
_assertError(lambda(() ycJson::decode("False"))  "decode: capitalized False errors")
_assertError(lambda(() ycJson::decode("nullx"))  "decode: nullx errors")
_assertErrorMsg(lambda(() ycJson::decode("true x")) "unexpected trailing characters"  "decode: trailing chars message")

; --- 数字 ---
_assert(ycJson::decode("42") == 42  "decode: 42")
_assert(fixp(ycJson::decode("42"))  "decode: 42 is fixnum")
_assert(ycJson::decode("-7") == -7  "decode: -7")
_assert(ycJson::decode("0") == 0  "decode: 0")
_assert(ycJson::decode("-0") == 0  "decode: -0 -> 0")
_assert(fixp(ycJson::decode("-0"))  "decode: -0 is fixnum")
_assert(ycJson::decode("3.14") == 3.14  "decode: 3.14")
_assert(floatp(ycJson::decode("3.14"))  "decode: 3.14 is flonum")
_assert(ycJson::decode("1e3") == 1000.0  "decode: 1e3")
_assert(floatp(ycJson::decode("1e3"))  "decode: 1e3 is flonum")
_assert(ycJson::decode("1E-2") == 0.01  "decode: 1E-2")
_assert(ycJson::decode("2.5e+2") == 250.0  "decode: 2.5e+2")
_assert(ycJson::decode("2147483647") == 2147483647  "decode: fixnum max")
_assert(fixp(ycJson::decode("2147483647"))  "decode: fixnum max stays fixnum")
_assert(floatp(ycJson::decode("2147483648"))  "decode: overflow int becomes flonum")
_assert(ycJson::decode("2147483648") == atof("2147483648")  "decode: overflow value preserved")
_assert(ycJson::decode("-2147483648") == -atof("2147483648")  "decode: fixnum min")
_assert(fixp(ycJson::decode("-2147483648"))  "decode: fixnum min stays fixnum")
_assert(floatp(ycJson::decode("99999999999999999999"))  "decode: huge int becomes flonum")
_assertError(lambda(() ycJson::decode("+1"))  "decode: +1 errors")
_assertError(lambda(() ycJson::decode("-"))  "decode: lone minus errors")
_assertError(lambda(() ycJson::decode(".5"))  "decode: .5 errors")
_assertError(lambda(() ycJson::decode("5."))  "decode: 5. errors")
_assertError(lambda(() ycJson::decode("01"))  "decode: 01 errors")
_assertError(lambda(() ycJson::decode("-01"))  "decode: -01 errors")
_assertError(lambda(() ycJson::decode("1e"))  "decode: 1e errors")
_assertError(lambda(() ycJson::decode("1e+"))  "decode: 1e+ errors")
_assertError(lambda(() ycJson::decode("1.e3"))  "decode: 1.e3 errors")
_assertError(lambda(() ycJson::decode("1.2.3"))  "decode: 1.2.3 errors")
_assertError(lambda(() ycJson::decode("--1"))  "decode: --1 errors")
_assertError(lambda(() ycJson::decode("Infinity"))  "decode: Infinity errors")
_assertError(lambda(() ycJson::decode("NaN"))  "decode: NaN errors")
_assertError(lambda(() ycJson::decode("0x10"))  "decode: 0x10 errors")

; --- 字符串 ---
_assert(ycJson::decode("\"\"") == ""  "decode: empty string")
_assert(ycJson::decode("\"abc\"") == "abc"  "decode: plain string")
_assert(ycJson::decode("\"a\\\"b\"") == strcat("a" intToChar(34) "b")  "decode: escaped quote")
_assert(ycJson::decode("\"a\\\\b\"") == strcat("a" intToChar(92) "b")  "decode: escaped backslash")
_assert(ycJson::decode("\"a\\/b\"") == "a/b"  "decode: escaped slash")
_assert(
    ycJson::decode("\"\\b\\f\\n\\r\\t\"")
        == strcat(intToChar(8) intToChar(12) intToChar(10) intToChar(13) intToChar(9))
    "decode: short escapes"
)
_assert(ycJson::decode("\"\\u0041\"") == "A"  "decode: \\u0041")
_assert(ycJson::decode("\"\\u4E2D\"") == "中"  "decode: \\u4E2D")
_assert(ycJson::decode("\"\\u00e9\"") == strcat(intToChar(195) intToChar(169))  "decode: \\u00e9 to utf-8 bytes")
_assert(
    ycJson::decode("\"\\ud83d\\ude00\"")
        == strcat(intToChar(240) intToChar(159) intToChar(152) intToChar(128))
    "decode: surrogate pair to utf-8 bytes"
)
_assert(ycJson::decode("\"中\"") == "中"  "decode: utf-8 passes through")
_assertError(lambda(() ycJson::decode("\"\\ud800\""))  "decode: lone high surrogate errors")
_assertError(lambda(() ycJson::decode("\"\\udc00\""))  "decode: lone low surrogate errors")
_assertError(lambda(() ycJson::decode("\"\\ud800x\""))  "decode: high surrogate without pair errors")
_assertError(lambda(() ycJson::decode("\"\\ud800\\u0041\""))  "decode: high surrogate with non-low errors")
_assertError(lambda(() ycJson::decode("\"\\u12g4\""))  "decode: invalid hex digit errors")
_assertError(lambda(() ycJson::decode("\"\\u12\""))  "decode: short \\u escape errors")
_assertError(lambda(() ycJson::decode("\"\\x\""))  "decode: invalid escape errors")
_assertError(lambda(() ycJson::decode("\"abc"))  "decode: unterminated string errors")
_assertError(lambda(() ycJson::decode(strcat("\"" "a" intToChar(10) "b" "\"")))  "decode: raw control char errors")

; --- 数组 ---
_assert(ycJson::decode("[]") == nil  "decode: empty array -> nil")
_assertDumpEq(ycJson::decode("[1,2,3]") list(1 2 3)  "decode: [1,2,3]")
_assertDumpEq(ycJson::decode("[ 1 , 2 ]") list(1 2)  "decode: array with inner whitespace")
_assertDumpEq(ycJson::decode("[[]]") list(nil)  "decode: nested empty array")
_assertDumpEq(ycJson::decode("[true,false,null]") list(ycJson::True ycJson::False ycJson::Null)  "decode: literal array")
_assertDumpEq(ycJson::decode("[1,[2,[3]]]") list(1 list(2 list(3)))  "decode: nested arrays")
_assert(car(ycJson::decode("[7]")) == 7  "decode: single element value")
_assertError(lambda(() ycJson::decode("[1,]"))  "decode: strict rejects trailing comma")
_assertError(lambda(() ycJson::decode("[,1]"))  "decode: rejects leading comma")
_assertError(lambda(() ycJson::decode("[1,,2]"))  "decode: rejects double comma")
_assertError(lambda(() ycJson::decode("[1"))  "decode: rejects unterminated array")
_assertError(lambda(() ycJson::decode("]"))  "decode: rejects stray close bracket")
_assertError(lambda(() ycJson::decode("[1]]"))  "decode: rejects extra close bracket")

; --- 对象 ---
_assert(length(ycJson::decode("{}")) == 0  "decode: empty object")
let((t_v)
    t_v = ycJson::decode("{\"a\":1}")
    _assert(length(t_v) == 1  "decode: object single key count")
    _assert(t_v["a"] == 1  "decode: object value")
    _assert(t_v["zz"] == ycJson::Missing  "decode: missing key returns Missing")
)
let((t_v)
    t_v = ycJson::decode("{\"a\":null,\"b\":false,\"c\":true}")
    _assert(t_v["a"] == ycJson::Null  "decode: object null value")
    _assert(t_v["b"] == ycJson::False  "decode: object false value")
    _assert(t_v["c"] == ycJson::True  "decode: object true value")
)
_assert(let((t_v) t_v = ycJson::decode("{\"a\":1,\"a\":2}") length(t_v) == 1)  "decode: duplicate keys collapse")
_assert(let((t_v) t_v = ycJson::decode("{\"a\":1,\"a\":2}") t_v["a"] == 2)  "decode: duplicate keys last wins")
let((t_v t_e t_in)
    t_v = ycJson::decode("{\"a\":{\"b\":[1]}}")
    t_e = makeTable("ycTest")
    t_in = makeTable("ycTest")
    t_in["b"] = list(1)
    t_e["a"] = t_in
    _assertDumpEq(t_v t_e  "decode: nested object")
)
_assertError(lambda(() ycJson::decode("{"))  "decode: rejects unterminated object")
_assertError(lambda(() ycJson::decode("{\"a\"}"))  "decode: rejects key without colon")
_assertError(lambda(() ycJson::decode("{\"a\":}"))  "decode: rejects missing value")
_assertError(lambda(() ycJson::decode("{\"a\":1,}"))  "decode: strict rejects object trailing comma")
_assertError(lambda(() ycJson::decode("{a:1}"))  "decode: rejects non-string key")
_assertError(lambda(() ycJson::decode("{\"a\" 1}"))  "decode: rejects missing colon")
_assertError(lambda(() ycJson::decode("{\"a\":1 \"b\":2}"))  "decode: rejects missing comma")
_assertError(lambda(() ycJson::decode("{,}"))  "decode: rejects comma without key")

; --- 嵌套深度 ---
_assert(errset(ycJson::decode(_nestArrays(1000)) nil) != nil  "decode: 1000-deep nesting ok")
_assertError(lambda(() ycJson::decode(_nestArrays(1001)))  "decode: 1001-deep nesting errors")
_assertErrorMsg(lambda(() ycJson::decode(_nestArrays(1001))) "nesting too deep"  "decode: deep nesting message")

; --- 错误位置 ---
_assertErrorMsg(lambda(() ycJson::decode("x")) "line 1, column 1"  "decode: error position line 1")
_assertErrorMsg(lambda(() ycJson::decode("\n\nx")) "line 3, column 1"  "decode: error position counts newlines")
_assertErrorMsg(lambda(() ycJson::decode("[1,\n2\n,x]")) "line 3, column 2"  "decode: array error position")
_assertErrorMsg(lambda(() ycJson::decode("{\"a\": 1,\n \"b\" 2}")) "line 2, column 6"  "decode: object error position")
_assertErrorMsg(lambda(() ycJson::decode("\"abc")) "unterminated string"  "decode: unterminated string message")

; --- 类型校验 ---
_assertError(lambda(() ycJson::decode(5))  "decode: rejects non-string input")
_assertError(lambda(() ycJson::decode(nil))  "decode: rejects nil input")

; --- JsonType（哨兵对象） ---
_assert(ycJson::JsonType("TRUE") == ycJson::True  "decode: constructor canonicalizes TRUE")
_assert(ycJson::JsonType("FALSE") == ycJson::False  "decode: constructor canonicalizes FALSE")
_assert(ycJson::JsonType("true") == ycJson::True  "decode: constructor returns the unique True instance")
_assert(ycJson::True->toSkill() == t  "decode: True toSkill is t")
_assert(ycJson::False->toSkill() == nil  "decode: False toSkill is nil")
_assert(ycJson::Null->toSkill() == 'unbound  "decode: Null toSkill is unbound")
_assert(ycJson::Missing->toSkill() == 'unbound  "decode: Missing toSkill is unbound")
_assertError(lambda(() ycJson::JsonType("xml"))  "decode: unknown JsonType name errors")
_assert(printself(ycJson::True) == "ycJson::JsonType(\"True\")"  "decode: JsonType printself format")
_assert(car(errset(evalstring(printself(ycJson::True)) nil)) == ycJson::True  "decode: JsonType evalstring roundtrip")
_assert(ycJson::decode("1 // c" ?format "jsonc") == 1  "decode: jsonc format dispatch")
_assertErrorMsg(lambda(() ycJson::decode("1" ?format "xml")) "unknown format"  "decode: unknown format errors")
_TestDecodeDone = t

; END
