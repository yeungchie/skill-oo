; --- jsonc：注释 ---
_assert(let((t_v) t_v = ycJson::Decode("{ // c\n \"a\": 1 }" ?format "jsonc") t_v["a"] == 1)  "jsonc: line comment")
_assert(ycJson::Decode("1 // c" ?format "jsonc") == 1  "jsonc: comment after scalar")
_assert(ycJson::Decode("// c\n1" ?format "jsonc") == 1  "jsonc: leading line comment")
_assert(ycJson::Decode("/* c */ 1" ?format "jsonc") == 1  "jsonc: leading block comment")
_assertDumpEq(ycJson::Decode("[1, /* c */ 2]" ?format "jsonc") list(1 2)  "jsonc: block comment inside array")
_assert(let((t_v) t_v = ycJson::Decode("{ \"a\" /* c */ : /* c */ 1 }" ?format "jsonc") t_v["a"] == 1)  "jsonc: comments between tokens")
_assert(ycJson::Decode("\"a//b\"" ?format "jsonc") == "a//b"  "jsonc: comment marker inside string")
_assert(ycJson::Decode("[] // c" ?format "jsonc") == nil  "jsonc: comment after empty array")

; --- jsonc：尾逗号 ---
_assertDumpEq(ycJson::Decode("[1,2,]" ?format "jsonc") list(1 2)  "jsonc: trailing comma array")
_assert(let((t_v) t_v = ycJson::Decode("{\"a\":1,}" ?format "jsonc") t_v["a"] == 1)  "jsonc: trailing comma object")
_assertError(lambda(() ycJson::Decode("[1,,]" ?format "jsonc"))  "jsonc: still rejects double comma")
_assertError(lambda(() ycJson::Decode("[,]" ?format "jsonc"))  "jsonc: rejects leading comma")
_assertError(lambda(() ycJson::Decode("{,}" ?format "jsonc"))  "jsonc: rejects leading comma in object")
_assertError(lambda(() ycJson::Decode("/* c" ?format "jsonc"))  "jsonc: unclosed block comment errors")
_assertErrorMsg(lambda(() ycJson::Decode("/* c" ?format "jsonc")) "unterminated block comment"  "jsonc: unclosed comment message")

; --- 严格模式不接受放宽 ---
_assertError(lambda(() ycJson::Decode("[1,]"))  "strict: rejects trailing comma")
_assertError(lambda(() ycJson::Decode("1 // c"))  "strict: rejects line comment")
_assertError(lambda(() ycJson::Decode("/* c */ 1"))  "strict: rejects block comment")

; --- jsonl：解析 ---
let((l_v)
    l_v = ycJson::Decode("1\n2\n" ?format "jsonl")
    _assert(length(l_v) == 2  "jsonl: two scalars count")
    _assert(car(l_v) == 1  "jsonl: first scalar")
    _assert(cadr(l_v) == 2  "jsonl: second scalar")
)
_assert(ycJson::Decode("" ?format "jsonl") == nil  "jsonl: empty input -> nil")
_assert(ycJson::Decode("\n \n\t\n" ?format "jsonl") == nil  "jsonl: blank lines only -> nil")
let((l_v)
    l_v = ycJson::Decode("1\n\n   \n2\n" ?format "jsonl")
    _assert(length(l_v) == 2  "jsonl: skips blank lines")
    _assert(cadr(l_v) == 2  "jsonl: value after blank lines")
)
let((l_v)
    l_v = ycJson::Decode("1\r\n2\r\n" ?format "jsonl")
    _assert(length(l_v) == 2  "jsonl: CRLF lines count")
    _assert(car(l_v) == 1 && cadr(l_v) == 2  "jsonl: CRLF values")
)
let((l_v t_v)
    l_v = ycJson::Decode("{\"a\":1}\n[1,2]\n" ?format "jsonl")
    t_v = car(l_v)
    _assert(length(l_v) == 2  "jsonl: mixed line count")
    _assert(t_v["a"] == 1  "jsonl: object line")
    _assertDumpEq(cadr(l_v) list(1 2)  "jsonl: array line")
)
let((l_v)
    l_v = ycJson::Decode("null\nfalse\ntrue\n" ?format "jsonl")
    _assert(car(l_v) == ycCodec::Null  "jsonl: null line")
    _assert(cadr(l_v) == ycCodec::False  "jsonl: false line")
    _assert(caddr(l_v) == ycCodec::True  "jsonl: true line")
)
_assert(length(ycJson::Decode("[]" ?format "jsonl")) == 1  "jsonl: empty array line kept")
_assert(car(ycJson::Decode("[]" ?format "jsonl")) == nil  "jsonl: empty array line is nil")

; --- jsonl：错误与行号 ---
_assertErrorMsg(lambda(() ycJson::Decode("1\n2\nx" ?format "jsonl")) "line 3, column 1"  "jsonl: error line 3")
_assertErrorMsg(lambda(() ycJson::Decode("1\nbad" ?format "jsonl")) "line 2, column 1"  "jsonl: error line 2")
_assertErrorMsg(lambda(() ycJson::Decode("\n\nbad" ?format "jsonl")) "line 3, column 1"  "jsonl: blank lines count in numbering")
_assertErrorMsg(lambda(() ycJson::Decode("{\"a\":1}\n{\"b\":}" ?format "jsonl")) "line 2"  "jsonl: object error line 2")
_assertErrorMsg(lambda(() ycJson::Decode("{\"a\":\n1}" ?format "jsonl")) "line 1"  "jsonl: split document error line 1")
_assertError(lambda(() ycJson::Decode("[1,]" ?format "jsonl"))  "jsonl: is strict")
_assertError(lambda(() ycJson::Decode("1 // c" ?format "jsonl"))  "jsonl: rejects comments")

; --- jsonl：输出 ---
_assert(ycJson::Encode(nil ?format "jsonl") == ""  "jsonl: empty list -> empty string")
_assert(ycJson::Encode(list(1) ?format "jsonl") == "1\n"  "jsonl: single line trailing newline")
_assert(ycJson::Encode(list(1 2) ?format "jsonl") == "1\n2\n"  "jsonl: two lines")
_assert(ycJson::Encode(list(1 2) ?format "jsonl" ?finalNewline nil) == "1\n2"  "jsonl: finalNewline nil omits trailing newline")
_assert(ycJson::Encode(list(1) ?format "jsonl" ?finalNewline nil) == "1"  "jsonl: finalNewline nil single line")
_assert(ycJson::Encode(nil ?format "jsonl" ?finalNewline nil) == ""  "jsonl: finalNewline nil empty list")
_assert(ycJson::Encode(list(nil) ?format "jsonl" ?nilAs "false") == "false\n"  "jsonl: nilAs false element")
_assert(ycJson::Encode(list(nil) ?format "jsonl") == "[]\n"  "jsonl: nil element is empty array")
_assert(ycJson::Encode(list(ycCodec::False ycCodec::Null) ?format "jsonl") == "false\nnull\n"  "jsonl: literals")
_assert(ycJson::Encode(list(strcat("a" intToChar(10) "b")) ?format "jsonl") == "\"a\\nb\"\n"  "jsonl: escapes newline inside string")
let((t_v)
    t_v = makeTable("ycTest")
    t_v["b"] = 1
    t_v["a"] = 2
    _assert(ycJson::Encode(list(t_v) ?format "jsonl" ?sortKeys t) == "{\"a\":2,\"b\":1}\n"  "jsonl: sorts keys when requested")
)
_assertError(lambda(() ycJson::Encode(5 ?format "jsonl"))  "jsonl: non-list errors")
let((l_v t_s)
    l_v = list(1 ycJson::Decode("{\"b\":[1],\"a\":2}") 1.5 "x" ycCodec::Null)
    t_s = ycJson::Encode(l_v ?format "jsonl")
    _assertDumpEq(ycJson::Decode(t_s ?format "jsonl") l_v  "jsonl: dump/parse roundtrip")
)

_TestVariantsDone = t

; END
