; --- 标量 ---
_assert(ycYaml::Decode("null") == ycCodec::Null  "decode: null")
_assert(ycYaml::Decode("~") == ycCodec::Null  "decode: tilde null")
_assert(ycYaml::Decode("Null") == ycCodec::Null  "decode: Null spelling")
_assert(ycYaml::Decode("") == ycCodec::Null  "decode: empty document is null")
_assert(ycYaml::Decode("# comment\n") == ycCodec::Null  "decode: comment-only document")
_assert(ycYaml::Decode("true") == ycCodec::True  "decode: true")
_assert(ycYaml::Decode("TRUE") == ycCodec::True  "decode: TRUE")
_assert(ycYaml::Decode("false") == ycCodec::False  "decode: false")
_assert(ycYaml::Decode("False") == ycCodec::False  "decode: False")
_assert(ycYaml::Decode("42") == 42  "decode: integer")
_assert(fixp(ycYaml::Decode("42"))  "decode: integer fixnum")
_assert(ycYaml::Decode("-7") == -7  "decode: negative integer")
_assert(ycYaml::Decode("0x10") == 16  "decode: hexadecimal")
_assert(ycYaml::Decode("0o10") == 8  "decode: octal")
_assert(ycYaml::Decode("0b101") == 5  "decode: binary")
_assert(ycYaml::Decode("1_000") == 1000  "decode: integer underscores")
_assert(ycYaml::Decode("3.14") == 3.14  "decode: float")
_assert(ycYaml::Decode("1e3") == 1000.0  "decode: exponent float")
_assert(ycYaml::Decode(".5") == 0.5  "decode: leading-dot float")
_assert(ycYaml::Decode("-2.5e-2") == -0.025  "decode: signed exponent float")
_assert(ycYaml::Decode(".inf") == atof("1e999")  "decode: infinity")
_assert(isNaN(ycYaml::Decode(".nan"))  "decode: nan")
_assert(ycYaml::Decode("hello") == "hello"  "decode: plain string")
_assert(ycYaml::Decode("hello world") == "hello world"  "decode: plain string with space")
_assert(ycYaml::Decode("a#b") == "a#b"  "decode: hash without preceding space is plain")
_assert(ycYaml::Decode("a # comment") == "a"  "decode: trailing comment")
_assert(ycYaml::Decode("\"a#b\"") == "a#b"  "decode: hash in double quote")
_assert(ycYaml::Decode("'a#b'") == "a#b"  "decode: hash in single quote")
_assert(ycYaml::Decode("'it''s'") == "it's"  "decode: single quote escape")
_assert(ycYaml::Decode("\"a\\nb\"") == strcat("a" intToChar(10) "b")  "decode: double quote newline escape")
_assert(ycYaml::Decode("\"\\u4e2d\"") == "中"  "decode: unicode escape")
_assert(ycYaml::Decode("\"a\\\"b\"") == strcat("a" intToChar(34) "b")  "decode: escaped quote")
_assert(ycYaml::Decode("\"a\\\\b\"") == strcat("a" intToChar(92) "b")  "decode: escaped backslash")
_assert(ycYaml::Decode("\"\"") == ""  "decode: empty double-quoted string")
_assert(ycYaml::Decode("''") == ""  "decode: empty single-quoted string")
_assert(ycYaml::Decode("http://example.com/a") == "http://example.com/a"  "decode: colon inside plain scalar")

; --- 块映射 ---
let((t_v)
    t_v = ycYaml::Decode("a: 1\nb: 2\n")
    _assert(t_v["a"] == 1  "map: first value")
    _assert(t_v["b"] == 2  "map: second value")
    _assert(t_v["zz"] == ycCodec::Missing  "map: missing key sentinel")
    _assert(length(t_v) == 2  "map: entry count")
)
_assert(length(ycYaml::Decode("{}\n")) == 0  "map: empty flow map")
let((t_v)
    t_v = ycYaml::Decode("a:\n")
    _assert(t_v["a"] == ycCodec::Null  "map: empty value is null")
)
let((t_v)
    t_v = ycYaml::Decode("a: \"\"\n")
    _assert(t_v["a"] == ""  "map: quoted empty value")
)
let((t_v)
    t_v = ycYaml::Decode("a: 1\na: 2\n")
    _assert(t_v["a"] == 2  "map: duplicate key last wins")
    _assert(length(t_v) == 1  "map: duplicate key collapses")
)
let((t_v)
    t_v = ycYaml::Decode("\"a:b\": 1\n3: x\n")
    _assert(t_v["a:b"] == 1  "map: colon in quoted key")
    _assert(t_v[3] == "x"  "map: integer key")
)
let((t_v)
    t_v = ycYaml::Decode("a:\n  b: 1\n  c: 2\nd: 3\n")
    _assert(t_v["a"]["b"] == 1  "map: nested value")
    _assert(t_v["a"]["c"] == 2  "map: nested second value")
    _assert(t_v["d"] == 3  "map: sibling after nested")
)
let((t_v)
    t_v = ycYaml::Decode("\n\n# leading comment\na: 1\n\nb: 2\n")
    _assert(t_v["a"] == 1  "blank: leading blank and comment skipped")
    _assert(t_v["b"] == 2  "blank: blank line inside block skipped")
)
; --- 块序列 ---
_assertDumpEq(ycYaml::Decode("- a\n- b\n") list("a" "b")  "seq: block strings")
_assertDumpEq(ycYaml::Decode("-\n- 2\n") list(ycCodec::Null 2)  "seq: empty item is null")
_assertDumpEq(ycYaml::Decode("- - a\n  - b\n- c\n") list(list("a" "b") "c")  "seq: nested sequence")
let((l_v)
    l_v = ycYaml::Decode("- name: a\n  n: 1\n- name: b\n  n: 2\n")
    _assert(length(l_v) == 2  "seq: map item count")
    _assert(car(l_v)["name"] == "a"  "seq: map item first key")
    _assert(car(l_v)["n"] == 1  "seq: map item second key")
    _assert(cadr(l_v)["name"] == "b"  "seq: second map item")
)
let((l_v)
    l_v = ycYaml::Decode("a:\n  - 1\n  - 2\nb: 3\n")
    _assert(car(l_v["a"]) == 1  "seq: nested under map")
    _assert(cadr(l_v["a"]) == 2  "seq: nested under map second")
    _assert(l_v["b"] == 3  "seq: map sibling after sequence")
)

; --- 流式集合 ---
_assertDumpEq(ycYaml::Decode("[1, 2, 3]") list(1 2 3)  "flow: sequence")
_assert(ycYaml::Decode("[]") == nil  "flow: empty sequence")
let((l_v t_v)
    t_v = makeTable("ycTest")
    t_v["d"] = "e"
    l_v = ycYaml::Decode("[a, [b, c], {d: e}]")
    _assertDumpEq(l_v list("a" list("b" "c") t_v)  "flow: nested collections")
)
let((t_v)
    t_v = ycYaml::Decode("{a: 1, b: [true, null], c: {d: 2}}")
    _assert(t_v["a"] == 1  "flow: map value")
    _assert(car(t_v["b"]) == ycCodec::True  "flow: map sequence boolean")
    _assert(cadr(t_v["b"]) == ycCodec::Null  "flow: map sequence null")
    _assert(t_v["c"]["d"] == 2  "flow: nested map")
)
_assertDumpEq(ycYaml::Decode("[1, 2,]") list(1 2)  "flow: trailing comma")
let((t_v)
    t_v = ycYaml::Decode("{a:}")
    _assert(t_v["a"] == ycCodec::Null  "flow: missing map value is null")
)
_assert(ycYaml::Decode("[a#b]") == list("a#b")  "flow: hash without preceding space is plain")
let((t_v)
    t_v = ycYaml::Decode("{a: 1, a: 2}")
    _assert(t_v["a"] == 2  "flow: duplicate key last wins")
)

; --- 块标量 ---
let((t_v)
    t_v = ycYaml::Decode("s: |\n  a\n  b\n")
    _assert(t_v["s"] == strcat("a" intToChar(10) "b" intToChar(10))  "block: literal")
)
let((t_v)
    t_v = ycYaml::Decode("s: >\n  a\n  b\n")
    _assert(t_v["s"] == strcat("a b" intToChar(10))  "block: folded")
)
let((t_v)
    t_v = ycYaml::Decode("s: >\n  a\n    b\n  c\n")
    _assert(
        t_v["s"] == strcat("a" intToChar(10) "  b" intToChar(10) "c" intToChar(10))
        "block: folded keeps more-indented line breaks"
    )
)
let((t_v)
    t_v = ycYaml::Decode("s: |-\n  a\n  b\n")
    _assert(t_v["s"] == strcat("a" intToChar(10) "b")  "block: strip chomping")
)
let((t_v)
    t_v = ycYaml::Decode("s: |+\n  a\n\n")
    _assert(t_v["s"] == strcat("a" intToChar(10) intToChar(10))  "block: keep chomping")
)
let((t_v)
    t_v = ycYaml::Decode("s: |2\n    a\n  b\n")
    _assert(t_v["s"] == strcat("  a" intToChar(10) "b" intToChar(10))  "block: explicit indentation")
)
_assert(ycYaml::Decode("|\n  abc\n") == strcat("abc" intToChar(10))  "block: top-level literal")

; --- 文档标记 ---
let((t_v)
    t_v = ycYaml::Decode("---\na: 1\n...\n")
    _assert(t_v["a"] == 1  "doc: explicit markers")
)
_assert(ycYaml::Decode("%YAML 1.2\n---\n42\n") == 42  "doc: version directive")
let((l_d)
    l_d = ycYaml::Decode("---\n1\n---\n2\n" ?format "yaml-stream")
    _assert(length(l_d) == 2  "stream: document count")
    _assert(car(l_d) == 1  "stream: first document")
    _assert(cadr(l_d) == 2  "stream: second document")
)
_assert(ycYaml::Decode("" ?format "yaml-stream") == nil  "stream: empty input")
_assert(ycYaml::Decode("# only\n---\n" ?format "yaml-stream") == list(ycCodec::Null)  "stream: empty document kept")
_assertError(lambda(() ycYaml::Decode("---\n1\n---\n2\n"))  "stream: multiple docs rejected by single format")

; --- 锚点、别名、标签 ---
let((t_v)
    t_v = ycYaml::Decode("base: &b {a: 1}\ncopy: *b\n")
    _assert(t_v["base"] == t_v["copy"]  "anchor: alias shares object")
    _assert(t_v["copy"]["a"] == 1  "anchor: alias value")
)
_assert(ycYaml::Decode("!!str 123") == "123"  "tag: !!str")
_assert(ycYaml::Decode("!!int \"12\"") == 12  "tag: !!int")
_assert(ycYaml::Decode("!!bool yes") == ycCodec::True  "tag: !!bool")
_assert(ycYaml::Decode("!!null x") == ycCodec::Null  "tag: !!null")
_assertError(lambda(() ycYaml::Decode("*missing"))  "anchor: unknown alias errors")
_assertError(lambda(() ycYaml::Decode("!!binary abc"))  "tag: unknown tag errors")

; --- 合并键 ---
let((t_v)
    t_v = ycYaml::Decode("base: &b {a: 1, b: 2}\nx:\n  <<: *b\n  b: 3\n")
    _assert(t_v["x"]["a"] == 1  "merge: inherited key")
    _assert(t_v["x"]["b"] == 3  "merge: explicit key wins")
    _assert(length(t_v["x"]) == 2  "merge: merged entry count")
    _assert(t_v["x"]["<<"] == ycCodec::Missing  "merge: merge key is not retained")
)

; --- 错误 ---
_assertError(lambda(() ycYaml::Decode("a: 1\n b: 2\n"))  "error: inconsistent indentation")
_assertError(lambda(() ycYaml::Decode("a: [1, 2\n"))  "error: unterminated flow sequence")
_assertError(lambda(() ycYaml::Decode("a: {b: 1\n"))  "error: unterminated flow map")
_assertError(lambda(() ycYaml::Decode("a: \"x\n"))  "error: unterminated double quote")
_assertError(lambda(() ycYaml::Decode("a: 'x\n"))  "error: unterminated single quote")
_assertError(lambda(() ycYaml::Decode("a: *nope\n"))  "error: unknown alias")
_assertError(lambda(() ycYaml::Decode("\ta: 1\n"))  "error: tab indentation")
_assertErrorMsg(lambda(() ycYaml::Decode("a: 1\n\tb: 2\n")) "line 2"  "error: tab indentation line number")
_assertError(lambda(() ycYaml::Decode("? complex\n: key\n"))  "error: complex key unsupported")
_assertError(lambda(() ycYaml::Decode("a: 1\n- b\n"))  "error: mixed map and sequence")
_assertErrorMsg(lambda(() ycYaml::Decode("a: [1, 2\n")) "line 1"  "error: message includes line")
_assertError(lambda(() ycYaml::Decode("a:\n  b:\n    c: 1\n" ?maxDepth 1))  "limit: nested block depth")
_assertError(lambda(() ycYaml::Decode("[[[1]]]" ?maxDepth 1))  "limit: nested flow depth")
let((t_v)
    t_v = ycYaml::Decode("a: 1\r\nb: 2\r\n")
    _assert(t_v["b"] == 2  "lines: CRLF input")
)
_assertError(lambda(() ycYaml::Decode(1))  "error: non-string input")
_assertError(lambda(() ycYaml::Decode("1" ?format "xml"))  "error: unknown format")
_assertError(lambda(() ycYaml::Decode("1" ?format 1))  "error: format type")
_assertError(lambda(() ycYaml::Decode("1" ?maxDepth "x"))  "limit: maxDepth type")
_assertError(lambda(() ycYaml::Decode("1" ?maxDepth 1.5))  "limit: maxDepth float")
_assert(ycYaml::Decode("[]" ?format "yaml") == nil  "format: yaml alias is default")
_TestDecodeDone = t

; END
