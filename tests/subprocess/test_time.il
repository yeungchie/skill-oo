_Assert(ycSubProcess::CreateJob("sleep 0")->start()->wait()->elapsed->getSeconds() <= 1 "elapsed seconds at most 1 for sleep 0")
_Assert(ycSubProcess::CreateJob("sleep 1")->start()->wait()->elapsed->getSeconds() <= 2 "elapsed seconds at most 2 for sleep 1")
_Assert(ycSubProcess::CreateJob("sleep 1")->start()->wait()->elapsed->getSeconds() >= 1 "elapsed seconds at least 1 for sleep 1")

let((aj)
    aj = ycSubProcess::CreateJob("sleep 0")
    _Assert(aj->elapsed->getStart() == nil "getStart is nil before the first mark")
    _Assert(aj->elapsed->getEnd() == nil "getEnd is nil before any mark")
    _Assert(printself(aj->elapsed) == "<ycSubProcess::Elapsed \"none\">" "Elapsed printself format before the first mark")
    _Assert(errset(aj->elapsed->getSeconds() nil) == nil "getSeconds raises before the timer starts")
    _Assert(stringp(aj->elapsed->mark()) "first mark returns the start time string")
    _Assert(stringp(aj->elapsed->getStart()) "getStart returns the recorded start time")
    _Assert(printself(aj->elapsed) == "<ycSubProcess::Elapsed \"active\">" "Elapsed printself format after the first mark")
    _Assert(aj->elapsed->getEnd() == nil "getEnd is nil after only the first mark")
    _Assert(errset(aj->elapsed->getSeconds() nil) == nil "getSeconds raises after only the first mark")
    _Assert(stringp(aj->elapsed->mark()) "second mark returns the end time string")
    _Assert(aj->elapsed->mark() == nil "mark after start and end has no effect")
)

let((aj t_h)
    aj = ycSubProcess::CreateJob("sleep 1")
    aj->start()->wait()
    t_h = aj->elapsed->humanReadable()
    _Assert(t_h == "1s" || t_h == "2s" "humanReadable reports a short human-readable duration")
)

let((aj t_t0 t_t1)
    aj = ycSubProcess::CreateJob("sleep 2")
    aj->start()
    t_t0 = getCurrentTime()
    aj->wait(1)
    t_t1 = getCurrentTime()
    _Assert(aj->state() == 'Active "wait with a timeout returns while the job is still running")
    _Assert(compareTime(t_t1 t_t0) < 2 "wait(1) on a longer job returns before the job ends")
    aj->wait()
    _Assert(aj->state() == 'Dead "wait without a timeout runs until the job ends")
    _Assert(aj->returncode == 0 "the finished job reports returncode 0")
)

let((aj)
    aj = ycSubProcess::CreateJob("sleep 2")
    aj->start()
    _Assert(aj->await() == "" "await waits for a longer job and returns its stdout")
    _Assert(aj->state() == 'Dead "the awaited job is dead")
)

let((el)
    el = makeInstance('ycSubProcess::Elapsed)
    _Assert(el->getStart() == nil "a directly built Elapsed has no start")
    _Assert(el->getEnd() == nil "a directly built Elapsed has no end")
    _Assert(errset(el->getSeconds() nil) == nil "getSeconds raises on a directly built Elapsed")
    _Assert(stringp(el->mark()) "the first mark on a directly built Elapsed records the start")
    _Assert(stringp(el->mark()) "the second mark on a directly built Elapsed records the end")
    _Assert(el->mark() == nil "a third mark on a directly built Elapsed is a no-op")
    _Assert(el->getSeconds() >= 0 "getSeconds yields a number after both marks")
)

_Assert(ycSubProcess::_FormatSeconds(0) == "~0s" "FormatSeconds: zero seconds")
_Assert(ycSubProcess::_FormatSeconds(1) == "1s" "FormatSeconds: one second")
_Assert(ycSubProcess::_FormatSeconds(59) == "59s" "FormatSeconds: under a minute")
_Assert(ycSubProcess::_FormatSeconds(60) == "1m" "FormatSeconds: exactly one minute")
_Assert(ycSubProcess::_FormatSeconds(61) == "1m1s" "FormatSeconds: one minute and one second")
_Assert(ycSubProcess::_FormatSeconds(3599) == "59m59s" "FormatSeconds: under an hour")
_Assert(ycSubProcess::_FormatSeconds(3600) == "1h" "FormatSeconds: exactly one hour")
_Assert(ycSubProcess::_FormatSeconds(3601) == "1h1s" "FormatSeconds: one hour and one second")
_Assert(ycSubProcess::_FormatSeconds(3660) == "1h1m" "FormatSeconds: one hour and one minute")
_Assert(ycSubProcess::_FormatSeconds(3661) == "1h1m1s" "FormatSeconds: one hour, one minute, one second")
_Assert(ycSubProcess::_FormatSeconds(7325) == "2h2m5s" "FormatSeconds: mixed multi-hour duration")

_TestTimeDone = t

; END
