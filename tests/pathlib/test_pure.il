; --- 解析 / str / parts / isAbsolute ---
_Assert(_S("/a/b/c.txt") == "/a/b/c.txt"  "str: /a/b/c.txt")
_Assert(_S("a//b") == "a/b"  "str: a//b collapses empty parts")
_Assert(_S("/") == "/"  "str: root")
_Assert(_S(".") == "."  "str: dot")
_Assert(_S("") == "."  "str: empty is dot")
_Assert(_S("a/") == "a"  "str: trailing slash dropped")
_Assert(_S("/a/") == "/a"  "str: absolute trailing slash dropped")
_Assert(_S("a/b/") == "a/b"  "str: relative trailing slash dropped")
_Assert(_S("a/.") == "a"  "str: dot part dropped")
_Assert(_S("./a") == "a"  "str: leading dot part dropped")
_Assert(_S("/a/b/../c") == "/a/b/../c"  "str: dotdot preserved")
_Assert(_S("../a") == "../a"  "str: leading dotdot preserved")
_Assert(_S("//a") == "/a"  "str: double slash normalized")

_AssertSameSeq(_P("/a/b/c.txt")->parts() list("/" "a" "b" "c.txt")  "parts: absolute")
_AssertSameSeq(_P("a//b")->parts() list("a" "b")  "parts: empty collapsed")
_AssertSameSeq(_P("/")->parts() list("/")  "parts: root")
_AssertSameSeq(_P(".")->parts() nil  "parts: dot empty")
_AssertSameSeq(_P("")->parts() nil  "parts: empty string")
_AssertSameSeq(_P("/a/b/../c")->parts() list("/" "a" "b" ".." "c")  "parts: dotdot kept")
_AssertSameSeq(_P("../a")->parts() list(".." "a")  "parts: leading dotdot kept")

_Assert(_P("/a/b")->isAbsolute()  "isAbsolute: yes")
_Assert(!_P("a/b")->isAbsolute()  "isAbsolute: no")
_Assert(_P("/")->isAbsolute()  "isAbsolute: root")
_Assert(!_P(".")->isAbsolute()  "isAbsolute: dot")
_Assert(_P("//a")->isAbsolute()  "isAbsolute: double slash")

_Assert(_P(_P("/a/b"))->str() == "/a/b"  "Path: accepts Path instance")
_AssertError(lambda(() ycPathLib::Path(42) t)  "Path: non string/Path errors")
_Assert(printself(_P("/a/b")) == "ycPathLib::Path(\"/a/b\")"  "printself format")
_Assert(car(errset(evalstring(printself(_P("/a/b"))) nil)) == _P("/a/b")  "printself: evalstring returns the same instance")

; --- name / stem / suffix / suffixes ---
_Assert(_P("/a/b/c.txt")->name() == "c.txt"  "name: file")
_Assert(_P("/")->name() == ""  "name: root empty")
_Assert(_P(".")->name() == ""  "name: dot empty")
_Assert(_P("a/b")->name() == "b"  "name: last part")

_Assert(_P("/a/b/c.txt")->stem() == "c"  "stem: simple")
_Assert(_P("archive.tar.gz")->stem() == "archive.tar"  "stem: multi suffix")
_Assert(_P("noext")->stem() == "noext"  "stem: no suffix")
_Assert(_P(".bashrc")->stem() == ".bashrc"  "stem: hidden file")
_Assert(_P("foo.")->stem() == "foo."  "stem: trailing dot keeps name")
_Assert(_P("..foo")->stem() == "."  "stem: ..foo -> .")
_Assert(_P("a..b")->stem() == "a."  "stem: a..b -> a.")
_Assert(_P("..")->stem() == ".."  "stem: dotdot")
_Assert(_P(".")->stem() == ""  "stem: dot empty name")

_Assert(_P("archive.tar.gz")->suffix() == ".gz"  "suffix: last only")
_Assert(_P("noext")->suffix() == ""  "suffix: none")
_Assert(_P(".bashrc")->suffix() == ""  "suffix: hidden none")
_Assert(_P("foo.")->suffix() == ""  "suffix: trailing dot none")
_Assert(_P("..foo")->suffix() == ".foo"  "suffix: ..foo")
_Assert(_P("a..b")->suffix() == ".b"  "suffix: a..b")
_Assert(_P("..")->suffix() == ""  "suffix: dotdot none")
_Assert(_P("/")->suffix() == ""  "suffix: root none")
_Assert(_P("a.b.c")->suffix() == ".c"  "suffix: a.b.c")

_AssertSameSeq(_P("archive.tar.gz")->suffixes() list(".tar" ".gz")  "suffixes: multi")
_AssertSameSeq(_P("noext")->suffixes() nil  "suffixes: none")
_AssertSameSeq(_P(".bashrc")->suffixes() nil  "suffixes: hidden none")
_AssertSameSeq(_P("foo.")->suffixes() nil  "suffixes: trailing dot none")
_AssertSameSeq(_P("..foo")->suffixes() nil  "suffixes: ..foo none")
_AssertSameSeq(_P("a..b")->suffixes() list("." ".b")  "suffixes: a..b")
_AssertSameSeq(_P("a.b.c")->suffixes() list(".b" ".c")  "suffixes: a.b.c")
_AssertSameSeq(_P("x.y.")->suffixes() nil  "suffixes: x.y. none")
_AssertSameSeq(_P("/")->suffixes() nil  "suffixes: root none")

; --- parent / parents ---
_Assert(_P("a/b")->parent()->str() == "a"  "parent: relative")
_Assert(_P("a")->parent()->str() == "."  "parent: single part -> dot")
_Assert(_P(".")->parent()->str() == "."  "parent: dot is self")
_Assert(_P("..")->parent()->str() == "."  "parent: dotdot drops")
_Assert(_P("/a")->parent()->str() == "/"  "parent: absolute single")
_Assert(_P("/")->parent()->str() == "/"  "parent: root is self")
_Assert(_P("a/b/c")->parent()->str() == "a/b"  "parent: deep")
_Assert(_P("/a/b")->parent()->str() == "/a"  "parent: absolute deep")

_AssertSameSeq(_Sl(_P("a/b")->parents()) list("a" ".")  "parents: a/b")
_AssertSameSeq(_Sl(_P("a")->parents()) list(".")  "parents: single part")
_AssertSameSeq(_Sl(_P(".")->parents()) nil  "parents: dot empty")
_AssertSameSeq(_Sl(_P("..")->parents()) list(".")  "parents: dotdot")
_AssertSameSeq(_Sl(_P("/a")->parents()) list("/")  "parents: absolute single")
_AssertSameSeq(_Sl(_P("/")->parents()) nil  "parents: root empty")
_AssertSameSeq(_Sl(_P("a/b/c")->parents()) list("a/b" "a" ".")  "parents: deep")
_AssertSameSeq(_Sl(_P("/a/b")->parents()) list("/a" "/")  "parents: absolute deep")

; --- join ---
_Assert(_P("/a")->join("b" "c")->str() == "/a/b/c"  "join: multi str")
_Assert(_P("a")->join("/b")->str() == "/b"  "join: absolute resets")
_Assert(_P("/a")->join(_P("b"))->str() == "/a/b"  "join: Path arg")
_Assert(_P("/a")->join("../b")->str() == "/a/../b"  "join: no dotdot fold")
_Assert(_P("")->join("a")->str() == "a"  "join: from empty")
_Assert(_P(".")->join("a")->str() == "a"  "join: from dot")
_Assert(_P("/")->join("a")->str() == "/a"  "join: from root")
_Assert(_P("/a/b")->join("../c")->str() == "/a/b/../c"  "join: keep dotdot")
_Assert(_P("/a")->join("./b")->str() == "/a/b"  "join: dot part dropped")
_AssertError(lambda(() _P("a")->join(42) t)  "join: bad segment errors")

; --- relativeTo / isRelativeTo ---
_Assert(_P("/a/b/c")->relativeTo("/a")->str() == "b/c"  "relativeTo: prefix")
_Assert(_P("a/b")->relativeTo("a/b")->str() == "."  "relativeTo: equal -> .")
_Assert(_P("/a/b")->relativeTo("/")->str() == "a/b"  "relativeTo: to root")
_Assert(_P("a/b")->relativeTo(".")->str() == "a/b"  "relativeTo: to dot")
_Assert(_P("a/b/c")->relativeTo("a")->str() == "b/c"  "relativeTo: single prefix")
_Assert(_P("/")->relativeTo("/")->str() == "."  "relativeTo: root to root")
_Assert(_P("a")->relativeTo(".")->str() == "a"  "relativeTo: to dot from part")

_AssertError(lambda(() _P("/a/b")->relativeTo(".") t)  "relativeTo: abs vs rel errors")
_AssertError(lambda(() _P("a")->relativeTo("b") t)  "relativeTo: no prefix errors")
_AssertError(lambda(() _P("/a")->relativeTo("b") t)  "relativeTo: abs vs rel single errors")
_AssertError(lambda(() _P(".")->relativeTo("a") t)  "relativeTo: dot vs part errors")
_AssertError(lambda(() _P("a/b")->relativeTo("a/c") t)  "relativeTo: sibling errors")
_AssertError(lambda(() _P("..")->relativeTo("a") t)  "relativeTo: dotdot errors")
_AssertError(lambda(() _P("/a/b")->relativeTo("/b") t)  "relativeTo: not prefix errors")
_AssertError(lambda(() _P("a/b")->relativeTo("/a") t)  "relativeTo: rel vs abs errors")
_AssertError(lambda(() _P("a")->relativeTo(42) t)  "relativeTo: bad arg errors")

_Assert(_P("/a/b/c")->isRelativeTo("/a")  "isRelativeTo: prefix yes")
_Assert(!_P("/a/b")->isRelativeTo(".")  "isRelativeTo: abs vs dot no")
_Assert(_P("a/b")->isRelativeTo("a/b")  "isRelativeTo: equal yes")
_Assert(_P("/a/b")->isRelativeTo("/")  "isRelativeTo: to root yes")
_Assert(_P("a/b")->isRelativeTo(".")  "isRelativeTo: to dot yes")
_Assert(_P("a/b/c")->isRelativeTo("a")  "isRelativeTo: single yes")
_Assert(!_P("/x/a/b")->isRelativeTo("a/b")  "isRelativeTo: anchor mismatch no")
_Assert(_P("/")->isRelativeTo("/")  "isRelativeTo: root yes")
_Assert(_P("a")->isRelativeTo(".")  "isRelativeTo: part vs dot yes")
_Assert(!_P("/a/b")->isRelativeTo("/b")  "isRelativeTo: sibling no")
_Assert(!_P("a")->isRelativeTo("b")  "isRelativeTo: different no")
_Assert(!_P("/a")->isRelativeTo("b")  "isRelativeTo: abs vs rel no")
_Assert(!_P(".")->isRelativeTo("a")  "isRelativeTo: dot vs part no")
_Assert(!_P("a/b")->isRelativeTo("a/c")  "isRelativeTo: branch no")
_Assert(!_P("a/b")->isRelativeTo("/a/c")  "isRelativeTo: rel vs abs no")
_Assert(!_P("..")->isRelativeTo("a")  "isRelativeTo: dotdot no")
_Assert(!_P("a/b")->isRelativeTo("/a")  "isRelativeTo: rel vs abs prefix no")
_Assert(_P("/x/a/b")->isRelativeTo("a") == nil  "isRelativeTo: abs self vs rel arg no")
_AssertError(lambda(() _P("a")->isRelativeTo(42) t)  "isRelativeTo: bad arg errors")

; --- withName ---
_Assert(_P("a/b.txt")->withName("b.md")->str() == "a/b.md"  "withName: replace")
_Assert(_P("a")->withName("c")->str() == "c"  "withName: single part")
_Assert(_P("/a/b")->withName("x")->str() == "/a/x"  "withName: absolute")
_Assert(_P("/a")->withName("z")->str() == "/z"  "withName: absolute single")
_Assert(_P("..")->withName("x")->str() == "x"  "withName: from dotdot")
_Assert(_P("a")->withName("..")->str() == ".."  "withName: to dotdot allowed")

_AssertError(lambda(() _P("a.b")->withName("") t)  "withName: empty name errors")
_AssertError(lambda(() _P(".")->withName("x") t)  "withName: self without name errors")
_AssertError(lambda(() _P("/")->withName("x") t)  "withName: root without name errors")
_AssertError(lambda(() _P("a")->withName("") t)  "withName: empty new name errors")
_AssertError(lambda(() _P("a/b")->withName("c/d") t)  "withName: slash in name errors")
_AssertError(lambda(() _P("a")->withName(".") t)  "withName: dot name errors")

; --- withSuffix ---
_Assert(_P("a/b.txt")->withSuffix(".md")->str() == "a/b.md"  "withSuffix: replace")
_Assert(_P("a/b")->withSuffix(".c")->str() == "a/b.c"  "withSuffix: add")
_Assert(_P("a/b")->withSuffix("")->str() == "a/b"  "withSuffix: empty keeps name")
_Assert(_P("a.tar.gz")->withSuffix(".xz")->str() == "a.tar.xz"  "withSuffix: last only")
_Assert(_P("..")->withSuffix(".x")->str() == "...x"  "withSuffix: from dotdot")
_Assert(_P("foo.")->withSuffix(".c")->str() == "foo..c"  "withSuffix: trailing dot")
_Assert(_P("a.b.c")->withSuffix(".d")->str() == "a.b.d"  "withSuffix: multi")
_Assert(_P("a")->withSuffix(".x")->str() == "a.x"  "withSuffix: no prior suffix")
_Assert(_P("a.b")->withSuffix(".x")->str() == "a.x"  "withSuffix: drops old suffix")
_Assert(_P(".bashrc")->withSuffix(".txt")->str() == ".bashrc.txt"  "withSuffix: hidden")
_Assert(_P("a")->withSuffix("")->str() == "a"  "withSuffix: empty on bare")
_Assert(_P("..")->withSuffix("")->str() == ".."  "withSuffix: empty on dotdot")
_Assert(_P("a/b.c")->withSuffix(".d.e")->str() == "a/b.d.e"  "withSuffix: dotted suffix")

_AssertError(lambda(() _P("a/b.txt")->withSuffix("c") t)  "withSuffix: no leading dot errors")
_AssertError(lambda(() _P(".")->withSuffix(".x") t)  "withSuffix: self without name errors")
_AssertError(lambda(() _P("/")->withSuffix(".x") t)  "withSuffix: root without name errors")
_AssertError(lambda(() _P("a/b.txt")->withSuffix(".c/d") t)  "withSuffix: slash errors")
_AssertError(lambda(() _P("a/b.txt")->withSuffix(".") t)  "withSuffix: bare dot errors")

; --- match ---
_Assert(_P("a/b/c.txt")->match("c.txt")  "match: name equals")
_Assert(_P("a/b/c.txt")->match("*.txt")  "match: name glob")
_Assert(_P("a/b/c.txt")->match("b/c.txt")  "match: suffix components")
_Assert(_P("a/b/c.txt")->match("a/b/c.txt")  "match: full relative")
_Assert(_P("/a/b/c.txt")->match("/a/b/c.txt")  "match: full anchored")
_Assert(!_P("/b/c.txt")->match("/c.txt")  "match: anchored not suffix")
_Assert(!_P("/a/b/c.txt")->match("/b/c.txt")  "match: anchored full only")
_Assert(_P("/a/b")->match("a/b")  "match: rel pattern on abs")
_Assert(_P("/x/a/b")->match("a/b")  "match: rel pattern right aligned")
_Assert(!_P("/x/a/b")->match("/a/b")  "match: anchored needs full")
_Assert(_P("a/b")->match("b")  "match: name via components")
    _Assert(_P("ab/c.txt")->match("?.txt")  "match: single char")
    _Assert(_P("a/b/c.txt")->match("?.txt")  "match: single char name")
    _Assert(_P("ab/c.txt")->match("[a-b]b/*.txt")  "match: char class range")
    _Assert(!_P("cb/c.txt")->match("[a-b]b/*.txt")  "match: char class range miss")
    _Assert(_P("hello.txt")->match("*.tx[ty]")  "match: char class")
    _Assert(!_P("hello.txt")->match("*.tx[yz]")  "match: char class miss")
_Assert(_P("/a/b")->match("/?/b")  "match: anchored single char")
_Assert(_P("/a/b")->match("/a/*")  "match: anchored star")
_Assert(!_P("/a/b/c")->match("/a/*")  "match: anchored star no cross")
_Assert(_P("a")->match("**")  "match: ** alone")
_Assert(_P("a/b")->match("**")  "match: ** alone multi")
_Assert(_P("x")->match("**")  "match: ** single")
_Assert(_P("a/b/c")->match("**")  "match: ** deep")
_Assert(!_P("a")->match("a/**")  "match: pattern longer")
_Assert(_P("a/b")->match("a/**")  "match: ** last")
_Assert(_P("a/b/c")->match("a/**/c")  "match: ** zero components")
_Assert(!_P("a/c")->match("a/**/c")  "match: ** needs component count")
_Assert(_P("a/b/c")->match("**/c")  "match: ** prefix")
_Assert(!_P("")->match("*")  "match: empty path vs star")
_Assert(!_P(".")->match("*")  "match: dot vs star")
_Assert(!_P("/")->match("*")  "match: root name empty vs star")
_Assert(_P("/")->match("/")  "match: root equals")
_Assert(_P("a")->match("a")  "match: equal")
_Assert(_P("a/b")->match("*")  "match: star as name")
_Assert(_P("a/b")->match("*/*")  "match: two stars")
_Assert(_P("a/b")->match("**/*")  "match: ** then star")
_Assert(_P("a/../b")->match("../b")  "match: dotdot literal")
_Assert(!_P("a/b/c")->match("/a/**")  "match: abs pattern vs rel path")
_Assert(_P("a/b/c")->match("**/**")  "match: double **")
_Assert(_P("a/b")->match("a/b/")  "match: trailing slash pattern")
_Assert(_P("a")->match("a/")  "match: trailing slash single")
_Assert(!_P("A.txt")->match("a.txt")  "match: case sensitive")
_Assert(!_P("a.txt")->match("A*")  "match: case sensitive star")
_Assert(_P("foo.txt")->match("*txt")  "match: star prefix")
_Assert(_P("foo.txt")->match("*")  "match: star all")
_Assert(_P("a/b/c")->match("b/c")  "match: suffix multi")
_Assert(_P("a*")->match("a*")  "match: literal star char")
_Assert(!_P("a/b")->match("a/b/c")  "match: pattern longer full")
_Assert(_P("/")->match("**")  "match: root vs **")
_Assert(_P("/a")->match("**")  "match: abs vs **")
_Assert(_P("..")->match("..")  "match: dotdot equals")
_Assert(_P("../a")->match("../a")  "match: dotdot prefix")
_Assert(!_P("a")->match("**/a")  "match: **/a vs single")
_Assert(!_P("a/b")->match("**/a")  "match: **/a right name mismatch")
_Assert(_P("a/b")->match("**/b")  "match: **/b")
_Assert(_P("/a")->match("**/a")  "match: rel ** prefix on abs path (phantom root line)")
_Assert(!_P("/a")->match("/a/**")  "match: abs n+1 only for root-only path")
_Assert(!_P("/a")->match("/")  "match: root pattern needs root-only path")

_AssertError(lambda(() _P(".")->match(".") t)  "match: empty pattern errors")
_AssertError(lambda(() _P("a")->match("") t)  "match: empty string errors")

; --- CurrentFile ---
_Assert(ycPathLib::CurrentFile()->name() == "test_pure.il"  "CurrentFile: name is loading file")
_Assert(ycPathLib::CurrentFile()->parent()->name() == "pathlib"  "CurrentFile: parent dir name")

; --- expandUser / absolute ---
let((t_home)
    t_home = getShellEnvVar("HOME")
    when(stringp(t_home) && t_home != ""
        _Assert(_P("~/x")->expandUser()->str() == _S(strcat(t_home "/x"))  "expandUser: ~/x -> HOME")
        _Assert(_P("~")->expandUser()->str() == _S(t_home)  "expandUser: ~ -> HOME")
        _Assert(_P("~/")->expandUser()->str() == _S(t_home)  "expandUser: ~/ -> HOME")
    )
    _AssertError(lambda(() _P("~other")->expandUser() t)  "expandUser: ~other errors")
)
_Assert(_P("/~x")->expandUser()->str() == "/~x"  "expandUser: absolute untouched")
_Assert(_P("a")->expandUser()->str() == "a"  "expandUser: no tilde untouched")
_Assert(_P("a/~")->expandUser()->str() == "a/~"  "expandUser: tilde not first")

_Assert(_P("a")->absolute()->str() == _S(strcat(getWorkingDir() "/a"))  "absolute: joins cwd")
_Assert(_P("/x/y")->absolute()->str() == "/x/y"  "absolute: keeps absolute")
_Assert(_P(".")->absolute()->str() == _S(getWorkingDir())  "absolute: dot -> cwd")

; --- interning（实例驻留） ---
_Assert(_P("/a/b") == _P("/a/b")  "intern: twin strings share one instance")
_Assert(_P("a//b") == _P("a/b")  "intern: empty-part normalization shares")
_Assert(_P("./a") == _P("a")  "intern: dot normalization shares")
_Assert(_P("/") == _P("//")  "intern: root twins share")
_Assert(_P("") == _P(".")  "intern: empty and dot share")
_Assert(_P("/a/b")->parent() == _P("/a")  "intern: parent shares with fresh")
_Assert(_P("/a")->join("b") == _P("/a/b")  "intern: join shares with fresh")
_Assert(_P("/a") != _P("/b")  "intern: distinct strings stay distinct")

; --- Path 构造：零参与多段 ---
_AssertOk(errset(ycPathLib::Path()->str() == "." t)  "Path: zero arg defaults to dot")
_Assert(_P("")->str() == "."  "Path: empty string is dot")
_AssertOk(errset(ycPathLib::Path("a" "b")->str() == "a/b" t)  "Path: two segments join")
_AssertOk(errset(ycPathLib::Path("a" "/b" "c")->str() == "/b/c" t)  "Path: absolute segment resets")
_AssertOk(errset(ycPathLib::Path(_P("a") "b")->str() == "a/b" t)  "Path: Path segment accepted")
_AssertError(lambda(() ycPathLib::Path("a" 5) t)  "Path: bad segment errors")

_TestPureDone = t

; END
