_TestParseDone = nil

; ---- 合法输入 ----
_Assert(ycRadix::Parse("0") == 0  "parse: zero")
_Assert(ycRadix::Parse("10") == 10  "parse: decimal")
_Assert(ycRadix::Parse("-10") == -10  "parse: negative")
_Assert(ycRadix::Parse("+10") == 10  "parse: plus sign")
_Assert(ycRadix::Parse("255") == 255  "parse: byte")
_Assert(ycRadix::Parse("2147483647") == 2147483647  "parse: signed max")
_Assert(ycRadix::Parse("-2147483648") == (-1 - 2147483647)  "parse: signed min")
_Assert(ycRadix::Parse("0b1010") == 10  "parse: binary prefix")
_Assert(ycRadix::Parse("0B1010") == 10  "parse: binary prefix upper")
_Assert(ycRadix::Parse("0o17") == 15  "parse: octal prefix")
_Assert(ycRadix::Parse("0O17") == 15  "parse: octal prefix upper")
_Assert(ycRadix::Parse("0x1f") == 31  "parse: hex prefix")
_Assert(ycRadix::Parse("0X1F") == 31  "parse: hex prefix upper")
_Assert(ycRadix::Parse("-0x10") == -16  "parse: negative hex")
_Assert(ycRadix::Parse("+0b11") == 3  "parse: positive binary")
_Assert(ycRadix::Parse("z" ?base 36) == 35  "parse: base 36 z")
_Assert(ycRadix::Parse("Z" ?base 36) == 35  "parse: base 36 Z")
_Assert(ycRadix::Parse("10" ?base 2) == 2  "parse: explicit binary")
_Assert(ycRadix::Parse("77" ?base 8) == 63  "parse: explicit octal")
_Assert(ycRadix::Parse("101" ?base 2 ?prefix nil) == 5  "parse: prefix disabled binary")
_Assert(ycRadix::Parse("0x10" ?base 16) == 16  "parse: matching explicit base")
_Assert(ycRadix::Parse("0x10" ?base nil) == 16  "parse: prefix inferred base")
_Assert(ycRadix::Parse("0xff" ?wrap t) == 255  "parse: wrap small")
_Assert(ycRadix::Parse("0x80000000" ?wrap t) == (-1 - 2147483647)  "parse: wrap sign bit")
_Assert(ycRadix::Parse("0xffffffff" ?wrap t) == -1  "parse: wrap all ones")
_Assert(ycRadix::Parse("4294967295" ?wrap t) == -1  "parse: wrap decimal all ones")
_Assert(ycRadix::Parse("-0x80000000" ?wrap t) == (-1 - 2147483647)  "parse: wrap negative min")
_Assert(ycRadix::Parse("0x7fffffff" ?wrap t) == 2147483647  "parse: wrap max")
_Assert(ycRadix::Parse("0" ?base 36) == 0  "parse: zero base 36")
_Assert(ycRadix::Parse("010") == 8  "parse: leading zero octal")
_Assert(ycRadix::Parse("00010") == 8  "parse: leading zeros octal")
_Assert(ycRadix::Parse("00") == 0  "parse: double zero octal")
_Assert(ycRadix::Parse("-010") == -8  "parse: negative octal")
_Assert(ycRadix::Parse("+010") == 8  "parse: plus octal")
_Assert(ycRadix::Parse("077") == 63  "parse: leading zero 077")
_Assert(ycRadix::Parse("010" ?base 10) == 10  "parse: explicit decimal overrides leading zero")
_Assert(ycRadix::Parse("010" ?base 16) == 16  "parse: explicit hex overrides leading zero")
_Assert(ycRadix::Parse("010" ?base 8) == 8  "parse: explicit octal leading zero")
_Assert(ycRadix::Parse("010" ?prefix nil) == 10  "parse: prefix disabled leading zero decimal")
_Assert(ycRadix::Parse("08" ?base 10) == 8  "parse: explicit decimal 08")
_Assert(ycRadix::Parse("09" ?base 10) == 9  "parse: explicit decimal 09")
_Assert(ycRadix::Parse("0x0" ?base 16) == 0  "parse: zero hex")
_Assert(ycRadix::Parse("1" ?base nil ?prefix nil) == 1  "parse: no prefix default")
_Assert(ycRadix::Parse("121" ?base 3) == 16  "parse: base 3")
_Assert(ycRadix::Parse("a" ?base 11) == 10  "parse: base 11 a")
_Assert(ycRadix::Parse("A" ?base 11) == 10  "parse: base 11 A")
_Assert(ycRadix::Parse("0o777" ?base 8) == 511  "parse: explicit octal prefix")
_Assert(ycRadix::Parse("0xffffffff" ?base 16 ?wrap t) == -1  "parse: explicit hex wrap")
_Assert(ycRadix::Parse("0b11111111111111111111111111111111" ?wrap t) == -1  "parse: 32 binary ones")
_Assert(ycRadix::Parse("0b1111111111111111111111111111111") == 2147483647  "parse: 31 binary ones")
_Assert(ycRadix::Parse("zz" ?base 36) == 1295  "parse: base 36 two digits")
_Assert(ycRadix::Parse("-0") == 0  "parse: negative zero")

; ---- 错误输入 ----
_AssertErrorMsg(
    lambda(() ycRadix::Parse(""))
    "ycRadix::Parse: expected a non-empty string"
    "parse error: empty"
)
_AssertError(lambda(() ycRadix::Parse("+"))  "parse error: plus only")
_AssertError(lambda(() ycRadix::Parse("-"))  "parse error: minus only")
_AssertError(lambda(() ycRadix::Parse("0x"))  "parse error: prefix only")
_AssertError(lambda(() ycRadix::Parse("0b"))  "parse error: binary prefix only")
_AssertError(lambda(() ycRadix::Parse("0o"))  "parse error: octal prefix only")
_AssertError(lambda(() ycRadix::Parse("0b2"))  "parse error: binary digit 2")
_AssertError(lambda(() ycRadix::Parse("1g" ?base 16))  "parse error: bad hex digit")
_AssertError(lambda(() ycRadix::Parse("2" ?base 2))  "parse error: digit outside base")
_AssertError(lambda(() ycRadix::Parse("08"))  "parse error: leading zero octal digit 8")
_AssertError(lambda(() ycRadix::Parse("09"))  "parse error: leading zero octal digit 9")
_AssertError(lambda(() ycRadix::Parse("0o8"))  "parse error: octal prefix digit 8")
_AssertError(lambda(() ycRadix::Parse("0o10" ?base 10))  "parse error: octal prefix base conflict")
_AssertError(lambda(() ycRadix::Parse("z" ?base 10))  "parse error: letter in decimal")
_AssertError(lambda(() ycRadix::Parse("1 0"))  "parse error: inner space")
_AssertError(lambda(() ycRadix::Parse(" 10"))  "parse error: leading space")
_AssertError(lambda(() ycRadix::Parse("10 "))  "parse error: trailing space")
_AssertError(lambda(() ycRadix::Parse("_10"))  "parse error: underscore")
_AssertError(lambda(() ycRadix::Parse("0x10" ?base 10))  "parse error: prefix base conflict")
_AssertError(lambda(() ycRadix::Parse("0x10" ?prefix nil))  "parse error: prefix disabled")
_AssertError(lambda(() ycRadix::Parse("2147483648"))  "parse error: signed overflow")
_AssertError(lambda(() ycRadix::Parse("0x100000000" ?wrap t))  "parse error: 33-bit wrap")
_AssertError(lambda(() ycRadix::Parse("-2147483649"))  "parse error: negative overflow")
_AssertError(lambda(() ycRadix::Parse("4294967296" ?wrap t))  "parse error: 33-bit decimal")
_AssertError(lambda(() ycRadix::Parse("-0x80000001" ?wrap t))  "parse error: negative wrap overflow")
_AssertError(lambda(() ycRadix::Parse("10" ?base 1))  "parse error: base 1")
_AssertError(lambda(() ycRadix::Parse("10" ?base 37))  "parse error: base 37")
_AssertError(lambda(() ycRadix::Parse("10" ?base "16"))  "parse error: base string")
_AssertError(lambda(() ycRadix::Parse("10" ?base 16.0))  "parse error: base float")
_AssertError(lambda(() ycRadix::Parse("10" ?prefix 1))  "parse error: prefix int")
_AssertError(lambda(() ycRadix::Parse("10" ?prefix "yes"))  "parse error: prefix string")
_AssertError(lambda(() ycRadix::Parse("10" ?wrap 1))  "parse error: wrap int")
_AssertError(lambda(() ycRadix::Parse(nil))  "parse error: nil text")
_AssertError(lambda(() ycRadix::Parse(10))  "parse error: int text")

_TestParseDone = t
