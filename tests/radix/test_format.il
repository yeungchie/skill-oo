_TestFormatDone = nil

; ---- 合法输入 ----
_Assert(ycRadix::Format(0) == "0"  "format: zero")
_Assert(ycRadix::Format(10) == "10"  "format: decimal")
_Assert(ycRadix::Format(-10) == "-10"  "format: negative")
_Assert(ycRadix::Format(255 ?base 16) == "ff"  "format: hex")
_Assert(ycRadix::Format(255 ?base 16 ?upper t) == "FF"  "format: hex upper")
_Assert(ycRadix::Format(255 ?base 16 ?prefix t) == "0xff"  "format: hex prefix")
_Assert(ycRadix::Format(255 ?base 16 ?prefix t ?upper t) == "0XFF"  "format: hex prefix upper")
_Assert(ycRadix::Format(255 ?base 2) == "11111111"  "format: binary")
_Assert(ycRadix::Format(255 ?base 2 ?prefix t ?width 8) == "0b11111111"  "format: binary prefix width")
_Assert(ycRadix::Format(255 ?base 8 ?prefix t) == "0o377"  "format: octal prefix")
_Assert(ycRadix::Format(35 ?base 36) == "z"  "format: base 36 z")
_Assert(ycRadix::Format(35 ?base 36 ?upper t) == "Z"  "format: base 36 Z")
_Assert(ycRadix::Format(10 ?base 36 ?upper t) == "A"  "format: base 36 A")
_Assert(ycRadix::Format(10 ?base 36 ?upper nil) == "a"  "format: base 36 a")
_Assert(ycRadix::Format(255 ?base 16 ?width 4) == "00ff"  "format: width hex")
_Assert(ycRadix::Format(255 ?base 16 ?prefix t ?width 4) == "0x00ff"  "format: prefix width")
_Assert(ycRadix::Format(255 ?base 16 ?prefix t ?upper t ?width 4) == "0X00FF"  "format: prefix upper width")
_Assert(ycRadix::Format(-255 ?base 16) == "-ff"  "format: negative hex")
_Assert(ycRadix::Format(-255 ?base 16 ?prefix t ?width 4) == "-0x00ff"  "format: negative prefix width")
_Assert(ycRadix::Format((-1 - 2147483647) ?base 16) == "-80000000"  "format: signed min hex")
_Assert(ycRadix::Format((-1 - 2147483647) ?base 2) == "-10000000000000000000000000000000"  "format: signed min binary")
_Assert(ycRadix::Format(2147483647 ?base 16) == "7fffffff"  "format: signed max hex")
_Assert(ycRadix::Format(0 ?base 2 ?prefix t ?width 8) == "0b00000000"  "format: zero binary pad")
_Assert(ycRadix::Format(0 ?base 16 ?prefix t ?width 2) == "0x00"  "format: zero hex pad")
_Assert(ycRadix::Format(1 ?base 2 ?width 0) == "1"  "format: zero width")
_Assert(ycRadix::Format(10 ?width 5 ?pad "x") == "xxx10"  "format: custom pad")
_Assert(ycRadix::Format(10 ?width 3 ?pad " ") == " 10"  "format: space pad")
_Assert(ycRadix::Format(10 ?prefix "0d") == "0d10"  "format: custom prefix")
_Assert(ycRadix::Format(10 ?prefix "") == "10"  "format: empty custom prefix")
_Assert(ycRadix::Format(10 ?prefix "0D" ?upper t) == "0D10"  "format: custom prefix unchanged")
_Assert(ycRadix::Format(255 ?base 16 ?prefix "0X" ?upper t) == "0XFF"  "format: custom prefix upper digits")
_Assert(ycRadix::Format(16 ?base 16 ?width 2) == "10"  "format: width no truncate")
_Assert(ycRadix::Format(-16 ?base 16 ?width 2) == "-10"  "format: negative width no truncate")
_Assert(ycRadix::Format(-1 ?base 2 ?width 8) == "-00000001"  "format: negative pad")
_Assert(ycRadix::Format(255 ?base 36) == "73"  "format: base 36")
_Assert(ycRadix::Format(35 ?base 2) == "100011"  "format: base 2")
_Assert(ycRadix::Format(1 ?base 36) == "1"  "format: base 36 one")
_Assert(ycRadix::Format(-0) == "0"  "format: negative zero")

; ---- 错误输入 ----
_AssertError(lambda(() ycRadix::Format(10 ?base 1))  "format error: base 1")
_AssertError(lambda(() ycRadix::Format(10 ?base 37))  "format error: base 37")
_AssertError(lambda(() ycRadix::Format(10 ?base "16"))  "format error: base string")
_AssertError(lambda(() ycRadix::Format(10 ?base 16.0))  "format error: base float")
_AssertError(lambda(() ycRadix::Format(10 ?prefix 1))  "format error: prefix int")
_AssertError(lambda(() ycRadix::Format(10 ?prefix 'x))  "format error: prefix symbol")
_AssertError(lambda(() ycRadix::Format(10 ?upper 1))  "format error: upper int")
_AssertError(lambda(() ycRadix::Format(10 ?width -1))  "format error: negative width")
_AssertError(lambda(() ycRadix::Format(10 ?width "2"))  "format error: width string")
_AssertError(lambda(() ycRadix::Format(10 ?width 2.0))  "format error: width float")
_AssertError(lambda(() ycRadix::Format(10 ?pad ""))  "format error: empty pad")
_AssertError(lambda(() ycRadix::Format(10 ?pad "00"))  "format error: multi pad")
_AssertError(lambda(() ycRadix::Format(10 ?pad 0))  "format error: int pad")
_AssertError(lambda(() ycRadix::Format(10 ?pad nil))  "format error: nil pad")
_AssertError(lambda(() ycRadix::Format(10 ?prefix t ?base 10))  "format error: prefix base 10")
_AssertError(lambda(() ycRadix::Format(1.5))  "format error: float value")
_AssertError(lambda(() ycRadix::Format("10"))  "format error: string value")
_AssertError(lambda(() ycRadix::Format(nil))  "format error: nil value")

_TestFormatDone = t
