_TestRectDone = nil

let((g_r)
    g_r = ycGeom::Rect(ycGeom::Point(10 4) ycGeom::Point(2 0))
    _Assert(classOf(g_r) == findClass('ycGeom::Rect)  "rect: class identity")
    _Assert(g_r->xmin() == 2.0  "rect: xmin")
    _Assert(g_r->ymin() == 0.0  "rect: ymin")
    _Assert(g_r->xmax() == 10.0  "rect: xmax")
    _Assert(g_r->ymax() == 4.0  "rect: ymax")
    _Assert(g_r->width() == 8.0  "rect: width")
    _Assert(g_r->height() == 4.0  "rect: height")
    _Assert(g_r->area() == 32.0  "rect: area")
    _Assert(g_r->center()->toSkill() == list(6.0 2.0)  "rect: center")
    _Assert(g_r->bBox() == list(list(2.0 0.0) list(10.0 4.0))  "rect: bBox")
    _Assert(g_r->toSkill() == list(list(2.0 0.0) list(10.0 4.0))  "rect: toSkill")
    _Assert(g_r->contains(ycGeom::Point(2 0))  "rect: contains min corner")
    _Assert(g_r->contains(ycGeom::Point(10 4))  "rect: contains max corner")
    _Assert(g_r->contains(ycGeom::Point(6 2))  "rect: contains inside")
    _Assert(!g_r->contains(ycGeom::Point(2.1 5))  "rect: outside")
)

let((g_r)
    g_r = ycGeom::Rect(list(list(0 0) list(5 3)))
    _Assert(g_r->toSkill() == list(list(0.0 0.0) list(5.0 3.0))  "rect: nested pair form")
)

let((g_r)
    g_r = ycGeom::Rect(0 0 5 3)
    _Assert(g_r->width() == 5.0  "rect: four-number form")
)

let((g_r)
    g_r = ycGeom::Rect(ycGeom::Point(1 1) ycGeom::Point(1 1))
    _Assert(g_r->width() == 0.0  "rect: degenerate width")
    _Assert(g_r->height() == 0.0  "rect: degenerate height")
    _Assert(g_r->area() == 0.0  "rect: degenerate area")
)

_AssertError(lambda(() ycGeom::Rect(1 2 3) t)  "rect: three coordinates rejected")
_AssertError(lambda(() ycGeom::Rect("a" "b") t)  "rect: non-point rejected")
_AssertError(lambda(() ycGeom::Rect(1 2 3 "x") t)  "rect: nonnumeric coordinate rejected")
_AssertError(lambda(() ycGeom::Rect(0 0 1 1)->contains(1) t)  "rect: bad contains type")

let((g_r)
    g_r = ycGeom::Rect(0 0 10 10)
    _Assert(classOf(g_r->size(1)) == findClass('ycGeom::Region)  "rect: size class")
    _Assert(g_r->size(1 ?corner 'miter)->area() == 144.0  "rect: size miter")
    _Assert(g_r->size(1 ?dir 'right)->area() == 110.0  "rect: size right")
    _Assert(g_r->size(1.2 ?ratio t)->area() == 144.0  "rect: size ratio")
    _Assert(ycGeom::Rect(1 1 1 1)->size(1)->isEmpty()  "rect: size degenerate")
)
_AssertErrorMsg(lambda(() ycGeom::Rect(0 0 4 4)->size(-1 ?ratio t) t)
    "ycGeom::Rect->size"  "rect: size ratio error context")

let((g_r g_p)
    g_r = ycGeom::Rect(2 0 10 4)
    g_p = g_r->toPolygon()
    _Assert(classOf(g_p) == findClass('ycGeom::Polygon)  "rect: toPolygon class")
    _Assert(g_p->toSkill() == list(
        list(2.0 0.0) list(10.0 0.0) list(10.0 4.0) list(2.0 4.0)
    )  "rect: toPolygon corners")
    _Assert(g_p->area() == 32.0  "rect: toPolygon area")
    _Assert(g_p->toRect()->toSkill() == g_r->toSkill()  "rect: toPolygon roundtrip")
    _Assert(ycGeom::Rect(1 1 1 1)->toPolygon() == nil  "rect: degenerate toPolygon")
)

let((g_a g_b)
    g_a = ycGeom::Rect(0 0 4 4)
    g_b = ycGeom::Rect(2 2 6 6)
    _Assert(g_a->or(g_b)->area() == 28.0  "rect: or")
    _Assert(g_a->and(g_b)->area() == 4.0  "rect: and")
    _Assert(g_a->not(g_b)->area() == 12.0  "rect: not")
    _Assert(g_a->xor(g_b)->area() == 24.0  "rect: xor")
)

let((g_rect g_poly g_region)
    g_rect = ycGeom::Rect(0 0 4 4)
    g_poly = ycGeom::Polygon('((2 2) (6 2) (6 6) (2 6)))
    g_region = ycGeom::Region(list(g_poly))
    _Assert(g_rect->or(g_poly)->area() == 28.0  "rect: or Polygon")
    _Assert(g_poly->or(g_region)->area() == 16.0  "polygon: or Region")
    _Assert(g_region->or(g_poly)->area() == 16.0  "region: or Polygon")
    _Assert(g_poly->and(g_rect)->area() == 4.0  "polygon: and Rect")
    _Assert(g_rect->and(g_region)->area() == 4.0  "rect: and Region")
    _Assert(g_region->or(g_rect)->area() == 28.0  "region: or Rect")
    _Assert(g_rect->or('((4 0) (8 0) (8 4) (4 4)))->area() == 32.0  "rect: or point list")
)

let((g_z g_r)
    g_z = ycGeom::Rect(1 1 1 1)
    g_r = ycGeom::Rect(0 0 2 2)
    _Assert(g_z->or(g_r)->area() == 4.0  "rect: degenerate union")
    _Assert(ycGeom::Rect(0 0 1e-10 1e-10)->or(g_r)->area() == 4.0  "rect: tiny treated empty")
    _Assert(g_r->and(g_z)->area() == 0.0  "rect: degenerate intersection")
)

_AssertError(lambda(() ycGeom::Rect(0 0 1 1)->or(ycGeom::Segment(0 0 1 1)) t)  "rect: booleans reject Segment")
_AssertError(lambda(() ycGeom::Polygon('((0 0) (1 0) (0 1)))->or(ycGeom::Line(0 0 1 0)) t)  "polygon: booleans reject Line")
_AssertError(lambda(() ycGeom::Region(nil)->and(ycGeom::Segment(0 0 1 1)) t)  "region: booleans reject Segment")

_TestRectDone = t

; END
