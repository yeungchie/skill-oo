_TestRectDone = nil

let((r)
    r = ycGeom::Rect(list(ycGeom::Point(10:4) ycGeom::Point(2:0)))
    _Assert(classOf(r) == findClass('ycGeom::Rect)  "rect: class identity")
    _Assert(r->xmin() == 2.0  "rect: xmin")
    _Assert(r->ymin() == 0.0  "rect: ymin")
    _Assert(r->xmax() == 10.0  "rect: xmax")
    _Assert(r->ymax() == 4.0  "rect: ymax")
    _Assert(r->width() == 8.0  "rect: width")
    _Assert(r->height() == 4.0  "rect: height")
    _Assert(r->area() == 32.0  "rect: area")
    _Assert(r->perimeter() == 24.0  "rect: perimeter")
    _Assert(r->center()->toSkill() == list(6.0 2.0)  "rect: center")
    _Assert(r->centroid()->toSkill() == list(6.0 2.0)  "rect: centroid")
    _Assert(r->bBox() == list(list(2.0 0.0) list(10.0 4.0))  "rect: bBox")
    _Assert(r->toSkill() == list(list(2.0 0.0) list(10.0 4.0))  "rect: toSkill")
    _Assert(r->contains(ycGeom::Point(2:0))  "rect: contains min corner")
    _Assert(r->contains(ycGeom::Point(10:4))  "rect: contains max corner")
    _Assert(r->contains(ycGeom::Point(6:2))  "rect: contains inside")
    _Assert(!r->contains(ycGeom::Point(2.1:5))  "rect: outside")
    _Assert(r->onBoundary(ycGeom::Point(2:2))  "rect: onBoundary left edge")
    _Assert(!r->onBoundary(ycGeom::Point(6:2))  "rect: onBoundary inside")
    _Assert(ycGeom::Rect(list(list(1e9 0) list(1e9 + 10 10)))->onBoundary(
        ycGeom::Point(list(1e9 + 1e-7 5)) ?eps 1e-9)
        "rect: onBoundary relative tolerance")
    _Assert(!r->contains(ycGeom::Point(2:2) ?boundary "outside")
        "rect: contains boundary outside")
    _Assert(r->contains(ycGeom::Point(2:2) ?boundary "inside")
        "rect: contains boundary inside")
)

let((r)
    r = ycGeom::Rect(list(list(0 0) list(5 3)))
    _Assert(r->toSkill() == list(list(0.0 0.0) list(5.0 3.0))  "rect: nested pair form")
)

_AssertError(lambda(() ycGeom::Rect(list(0 0 5 3)) t)
    "rect: four-number form rejected")

let((r)
    r = ycGeom::Rect(list(ycGeom::Point(1:1) ycGeom::Point(1:1)))
    _Assert(r->width() == 0.0  "rect: degenerate width")
    _Assert(r->height() == 0.0  "rect: degenerate height")
    _Assert(r->area() == 0.0  "rect: degenerate area")
    _Assert(r->perimeter() == 0.0  "rect: degenerate perimeter")
    _Assert(r->onBoundary(ycGeom::Point(1:1))  "rect: degenerate onBoundary")
)

_AssertError(lambda(() ycGeom::Rect(list(1 2 3)) t)  "rect: three coordinates rejected")
_AssertError(lambda(() ycGeom::Rect(list("a" "b")) t)  "rect: non-point rejected")
_AssertError(lambda(() ycGeom::Rect(list(1 2 3 "x")) t)  "rect: nonnumeric coordinate rejected")
_AssertError(lambda(() ycGeom::Rect(list(0:0 1:1))->contains(1) t)  "rect: bad contains type")
_AssertError(lambda(() ycGeom::Rect(list(0:0 1:1))->contains(
    ycGeom::Point(0:0) ?boundary "bad") t)  "rect: bad contains boundary")
_AssertError(lambda(() ycGeom::Rect(list(0:0 1:1))->onBoundary(
    ycGeom::Point(0:0) ?eps 0) t)  "rect: bad onBoundary eps")

let((r)
    r = ycGeom::Rect(list(0:0 10:10))
    _Assert(classOf(r->size(1)) == findClass('ycGeom::Region)  "rect: size class")
    _Assert(r->size(1 ?corner 'miter)->area() == 144.0  "rect: size miter")
    _Assert(r->size(1 ?dir 'right)->area() == 110.0  "rect: size right")
    _Assert(r->size(1.2 ?ratio t)->area() == 144.0  "rect: size ratio")
    _Assert(ycGeom::Rect(list(1:1 1:1))->size(1)->isEmpty()  "rect: size degenerate")
)
_AssertErrorMsg(lambda(() ycGeom::Rect(list(0:0 4:4))->size(-1 ?ratio t) t)
    "ycGeom::Rect->size"  "rect: size ratio error context")

let((r p)
    r = ycGeom::Rect(list(2:0 10:4))
    p = r->toPolygon()
    _Assert(classOf(p) == findClass('ycGeom::Polygon)  "rect: toPolygon class")
    _Assert(p->toSkill() == list(
        list(2.0 0.0) list(10.0 0.0) list(10.0 4.0) list(2.0 4.0)
    )  "rect: toPolygon corners")
    _Assert(p->area() == 32.0  "rect: toPolygon area")
    _Assert(p->toRect()->toSkill() == r->toSkill()  "rect: toPolygon roundtrip")
    _Assert(ycGeom::Rect(list(1:1 1:1))->toPolygon() == nil  "rect: degenerate toPolygon")
)

let((a b)
    a = ycGeom::Rect(list(0:0 4:4))
    b = ycGeom::Rect(list(2:2 6:6))
    _Assert(a->or(b)->area() == 28.0  "rect: or")
    _Assert(a->and(b)->area() == 4.0  "rect: and")
    _Assert(a->not(b)->area() == 12.0  "rect: not")
    _Assert(a->xor(b)->area() == 24.0  "rect: xor")
)

let((rect poly region)
    rect = ycGeom::Rect(list(0:0 4:4))
    poly = ycGeom::Polygon('((2 2) (6 2) (6 6) (2 6)))
    region = ycGeom::Region(list(poly))
    _Assert(rect->or(poly)->area() == 28.0  "rect: or Polygon")
    _Assert(poly->or(region)->area() == 16.0  "polygon: or Region")
    _Assert(region->or(poly)->area() == 16.0  "region: or Polygon")
    _Assert(poly->and(rect)->area() == 4.0  "polygon: and Rect")
    _Assert(rect->and(region)->area() == 4.0  "rect: and Region")
    _Assert(region->or(rect)->area() == 28.0  "region: or Rect")
    _Assert(rect->or('((4 0) (8 0) (8 4) (4 4)))->area() == 32.0  "rect: or point list")
)

let((z r)
    z = ycGeom::Rect(list(1:1 1:1))
    r = ycGeom::Rect(list(0:0 2:2))
    _Assert(z->or(r)->area() == 4.0  "rect: degenerate union")
    _Assert(ycGeom::Rect(list(0:0 1e-10:1e-10))->or(r)->area() == 4.0  "rect: tiny treated empty")
    _Assert(r->and(z)->area() == 0.0  "rect: degenerate intersection")
    _Assert(ycGeom::Rect(list(0:0 1e-5:1e-5))->toPolygon() != nil
        "rect: small nonzero toPolygon")
)

_Assert(ycGeom::Rect(list(0:0 1e-5:1e-5))->or(ycGeom::Rect(list(0:0 2:2)))->area() == 4.0
    "rect: small nonzero union")

_AssertError(lambda(() ycGeom::Rect(list(0:0 1:1))->or(ycGeom::Segment(list(0:0 1:1))) t)  "rect: booleans reject Segment")
_AssertError(lambda(() ycGeom::Polygon('((0 0) (1 0) (0 1)))->or(ycGeom::Line(list(0:0 1:0))) t)  "polygon: booleans reject Line")
_AssertError(lambda(() ycGeom::Region(nil)->and(ycGeom::Segment(list(0:0 1:1))) t)  "region: booleans reject Segment")

_TestChildDone = t

; END
