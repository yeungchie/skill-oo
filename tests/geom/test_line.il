_TestLineDone = nil

let((l)
    l = ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(10:0)))
    _Assert(classOf(l) == findClass('ycGeom::Line)  "line: class identity")
    _Assert(l->a() == 0.0  "line: horizontal a")
    _Assert(l->b() == -1.0  "line: horizontal b")
    _Assert(l->c() == 0.0  "line: horizontal c")
    _Assert(l->anchor()->toSkill() == list(0.0 0.0)  "line: anchor")
    _Assert(l->direction() == list(1.0 0.0)  "line: direction")
    _Assert(l->normal() == list(0.0 -1.0)  "line: normal")
    _Assert(l->project(ycGeom::Point(3:5))->toSkill() == list(3.0 0.0)  "line: project")
    _Assert(l->distanceTo(ycGeom::Point(3:5)) == 5.0  "line: distance")
    _Assert(l->contains(ycGeom::Point(3:0))  "line: contains")
    _Assert(l->toSkill() == list(list(0.0 0.0) list(1.0 0.0))  "line: toSkill")
)

let((v)
    v = ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(0:10)))
    _Assert(v->a() == 1.0  "line: vertical a")
    _Assert(v->b() == 0.0  "line: vertical b")
    _Assert(v->direction() == list(0.0 1.0)  "line: vertical direction")
    _Assert(v->project(ycGeom::Point(5:3))->toSkill() == list(0.0 3.0)  "line: vertical project")
    _Assert(v->isParallel(ycGeom::Line(list(ycGeom::Point(1:0) ycGeom::Point(1:10))))  "line: parallel")
    _Assert(!v->isParallel(ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(10:0))))  "line: not parallel")
)

let((h)
    h = ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(10:0)))
    _Assert(h->intersection(ycGeom::Line(list(ycGeom::Point(5:-5) ycGeom::Point(5:5))))->toSkill() == list(5.0 0.0)  "line: line intersection")
    _Assert(h->intersection(ycGeom::Line(list(ycGeom::Point(0:1) ycGeom::Point(10:1)))) == nil  "line: parallel nil")
    _Assert(h->intersection(ycGeom::Segment(list(ycGeom::Point(5:-5) ycGeom::Point(5:5))))->toSkill() == list(5.0 0.0)  "line: segment intersection")
    _Assert(h->intersection(ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(10:0))))->start()->toSkill() == list(0.0 0.0)  "line: collinear overlap")
)

_AssertError(lambda(() ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(0:0))) t)  "line: coincident points rejected")
_AssertError(lambda(() ycGeom::Line(list(1 ycGeom::Point(0:0))) t)  "line: non-Point rejected")
_AssertError(lambda(() ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(1:1)))->isParallel(1) t)  "line: bad parallel type")

let((l)
    l = ycGeom::Line(list(0:0 10:0))
    _Assert(l->isParallel(list(0:1 1:1))  "line: array parallel")
    _Assert(l->intersection(list(5:-5 5:5) ?as 'Line)->toSkill() == list(5.0 0.0)
        "line: array intersection as Line")
    _Assert(l->intersection(list(5:-5 5:5) ?as 'Segment)->toSkill() == list(5.0 0.0)
        "line: array intersection as Segment")
    _AssertErrorMsg(lambda(() l->intersection(list(5:-5 5:5)) t)
        "?as"  "line: ambiguous array intersection requires ?as")
    _AssertErrorMsg(lambda(() l->intersection(list(5:-5 5:5) ?as 'Rect) t)
        "?as"  "line: invalid array target rejected")
)

let((l o)
    o = ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(3:4)))
    _Assert(ycGeom::Line(list(ycGeom::Point(0:0) ycGeom::Point(3:4)))->toSkill() == o->toSkill()  "line: two-point list form")
    _Assert(ycGeom::Line(list(list(0 0) list(3 4)))->toSkill() == o->toSkill()  "line: pair list form")
    _AssertError(lambda(() ycGeom::Line(list(0 0 3 4)) t)  "line: four-number form rejected")
    _Assert(ycGeom::Line(o->toSkill())->toSkill() == o->toSkill()  "line: toSkill roundtrip")
)
_AssertError(lambda(() ycGeom::Line(list(1 2)) t)  "line: two numbers rejected")
_AssertError(lambda(() ycGeom::Line(list(list(1 2))) t)  "line: one-point list rejected")

_TestChildDone = t

; END
