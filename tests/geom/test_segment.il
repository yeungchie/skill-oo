_TestSegmentDone = nil

let((s p)
    s = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(10:0)))
    _Assert(classOf(s) == findClass('ycGeom::Segment)  "segment: class identity")
    _Assert(s->start()->toSkill() == list(0.0 0.0)  "segment: start")
    _Assert(s->end()->toSkill() == list(10.0 0.0)  "segment: end")
    _Assert(s->length() == 10.0  "segment: length")
    _Assert(s->midpoint()->toSkill() == list(5.0 0.0)  "segment: midpoint")
    _Assert(car(s->direction()) == 1.0  "segment: direction x")
    _Assert(cadr(s->direction()) == 0.0  "segment: direction y")
    _Assert(s->bBox() == list(list(0.0 0.0) list(10.0 0.0))  "segment: bBox")
    _Assert(s->toSkill() == list(list(0.0 0.0) list(10.0 0.0))  "segment: toSkill")
    p = ycGeom::Point(15:5)
    _Assert(s->project(p) == nil  "segment: projection outside")
    _Assert(s->project(ycGeom::Point(3:5))->toSkill() == list(3.0 0.0)  "segment: projection inside")
    _Assert(s->project(ycGeom::Point(10:5))->toSkill() == list(10.0 0.0)  "segment: projection endpoint")
    _Assert(s->nearestPoint(p)->toSkill() == list(10.0 0.0)  "segment: nearest endpoint")
    _Assert(abs(s->distanceTo(p) - sqrt(50.0)) <= 1e-9  "segment: distance")
    _Assert(s->contains(ycGeom::Point(5:0))  "segment: contains")
)
let((s)
    s = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(3:4)))
    _Assert(s->length() == 5.0  "segment: diagonal length")
    _Assert(s->midpoint()->toSkill() == list(1.5 2.0)  "segment: diagonal midpoint")
    _Assert(car(s->direction()) == 0.6  "segment: diagonal direction x")
    _Assert(cadr(s->direction()) == 0.8  "segment: diagonal direction y")
)

let((s z)
    z = ycGeom::Segment(list(ycGeom::Point(1:1) ycGeom::Point(1:1)))
    _Assert(z->length() == 0.0  "segment: zero length")
    _Assert(z->direction() == nil  "segment: zero direction")
    _Assert(z->project(ycGeom::Point(2:2))->toSkill() == list(1.0 1.0)  "segment: zero projection")
    s = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(10:0)))
    _Assert(s->intersection(ycGeom::Segment(list(ycGeom::Point(5:-5) ycGeom::Point(5:5))))->toSkill() == list(5.0 0.0)  "segment: segment intersection")
    _Assert(s->intersection(ycGeom::Line(list(ycGeom::Point(0:1) ycGeom::Point(10:1)))) == nil  "segment: parallel line")
)

let((s d z)
    s = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(10:0)))
    _Assert(classOf(s->toRect()) == findClass('ycGeom::Rect)  "segment: toRect class")
    _Assert(s->toRect()->bBox() == list(list(0.0 0.0) list(10.0 0.0))  "segment: toRect horizontal")
    d = ycGeom::Segment(list(ycGeom::Point(3:4) ycGeom::Point(1:2)))
    _Assert(d->toRect()->toSkill() == list(list(1.0 2.0) list(3.0 4.0))  "segment: toRect diagonal")
    z = ycGeom::Segment(list(ycGeom::Point(1:1) ycGeom::Point(1:1)))
    _Assert(z->toRect()->area() == 0.0  "segment: toRect zero length")
)

let((a b)
    a = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(10:0)))
    b = ycGeom::Segment(list(ycGeom::Point(5:0) ycGeom::Point(15:0)))
    _Assert(a->intersection(b)->start()->toSkill() == list(5.0 0.0)  "segment: collinear overlap start")
    _Assert(a->intersection(b)->end()->toSkill() == list(10.0 0.0)  "segment: collinear overlap end")
)

_AssertError(lambda(() ycGeom::Segment(list(1 2)) t)  "segment: non-Point start rejected")
_AssertError(lambda(() ycGeom::Segment(list(ycGeom::Point(0:0) 2)) t)  "segment: non-Point end rejected")
_AssertError(lambda(() ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(1:1)))->intersection(1) t)  "segment: bad intersection type")

let((s)
    s = ycGeom::Segment(list(0:0 10:0))
    _Assert(s->intersection(list(5:-5 5:5) ?as 'Line)->toSkill() == list(5.0 0.0)
        "segment: array intersection as Line")
    _Assert(s->intersection(list(5:-5 5:5) ?as 'Segment)->toSkill() == list(5.0 0.0)
        "segment: array intersection as Segment")
    _AssertErrorMsg(lambda(() s->intersection(list(5:-5 5:5)) t)
        "?as"  "segment: ambiguous array intersection requires ?as")
    _AssertErrorMsg(lambda(() s->intersection(list(5:-5 5:5) ?as 'Rect) t)
        "?as"  "segment: invalid array target rejected")
)

let((s o)
    o = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(3:4)))
    _Assert(ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(3:4)))->toSkill() == o->toSkill()  "segment: two-point list form")
    _Assert(ycGeom::Segment(list(list(0 0) list(3 4)))->toSkill() == o->toSkill()  "segment: pair list form")
    _AssertError(lambda(() ycGeom::Segment(list(0 0 3 4)) t)  "segment: four-number form rejected")
    _Assert(ycGeom::Segment(o->toSkill())->toSkill() == o->toSkill()  "segment: toSkill roundtrip")
)
_AssertError(lambda(() ycGeom::Segment(list(1 2)) t)  "segment: two numbers rejected")
_AssertError(lambda(() ycGeom::Segment(list(list(1 2))) t)  "segment: one-point list rejected")

let((s z l)
    s = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(10:0)))
    l = s->toLine()
    _Assert(classOf(l) == findClass('ycGeom::Line)  "segment: toLine class")
    _Assert(l->contains(ycGeom::Point(-5:0))  "segment: toLine extends")
    z = ycGeom::Segment(list(ycGeom::Point(1:1) ycGeom::Point(1:1)))
    _Assert(z->toLine() == nil  "segment: toLine zero length")
)

let((s)
    s = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(1e-3:0)))
    _Assert(!s->contains(ycGeom::Point(0.5e-3:1e-6))
        "segment: cross tolerance is scale independent")
    s = ycGeom::Segment(list(ycGeom::Point(0:0) ycGeom::Point(1000:0)))
    _Assert(s->contains(ycGeom::Point(list(1000 + 1e-9 0)))
        "segment: endpoint tolerance is scale independent")
)

_TestChildDone = t

; END
